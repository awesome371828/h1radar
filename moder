                            const id = String(e.features[0].properties.id)
                              , m = MARKS.find(x => String(x.id) === id);
                            if (!m)
                                return;
                            const el = document.createElement('div');
                            el.className = 'pp';
                            el.innerHTML = `<b style="color:${MK[m.kind] || '#fff'}">${esc(m.label)}</b> · ${esc(m.district || 'без района')}
        <div class="m">${hm(m.ts)} · ${ago(m.ts)}</div><div class="m">автор <span class="mono">${esc(m.author.pub)}</span>${m.acc ? ' · ±' + Math.round(m.acc) + ' м' : ''}</div>
        <div style="display:flex;gap:6px;flex-wrap:wrap"><button class="ab" data-goto="${esc(id)}">В списке</button>
        ${can('marks') ? `<button class="ab del" data-pdel="${esc(id)}">Убрать</button>` : ''}</div>`;
                            const pop = new maplibregl.Popup({
                                closeButton: true,
                                maxWidth: '280px'
                            }).setLngLat([m.lon, m.lat]).setDOMContent(el).addTo(MMAP);
                            el.onclick = ev => {
                                const g = ev.target.closest('[data-goto]')
                                  , d = ev.target.closest('[data-pdel]');
