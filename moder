            .cact {
                display: flex;
                flex-direction: column;
                gap: 2px
            }

            .cpin {
                width: 24px;
                height: 24px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--dim);
                opacity: 0;
                transition: opacity .15s
            }

            .cpin svg {
                width: 14px;
                height: 14px
            }

            .cm:hover .cpin {
                opacity: 1
            }

            .cpin:hover {
                color: var(--cyan);
                background: rgba(99,220,255,.12)
            }

            /* отмена действия */
            #undo {
                position: fixed;
                left: 50%;
                bottom: 28px;
                z-index: 72;
                transform: translate(-50%,30px);
                opacity: 0;
                pointer-events: none;
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 10px 10px 10px 18px;
                border-radius: 18px;
                overflow: hidden;
                background: rgba(9,22,46,.97);
                border: 1px solid var(--edge2);
                box-shadow: 0 16px 40px rgba(0,0,0,.5);
                transition: all .3s var(--ease);
                max-width: calc(100% - 24px);
                font-size: 14px
            }

            #undo.on {
                opacity: 1;
                transform: translate(-50%,0);
                pointer-events: auto
            }

            #undo button {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                padding: 9px 14px;
                border-radius: 12px;
                font-weight: 700;
                font-size: 13.5px;
                color: #04122b;
                background: linear-gradient(180deg,#ffe29a,#f5c04e);
                white-space: nowrap
            }

            #undo button svg {
                width: 16px;
                height: 16px
            }

            #undo i {
                position: absolute;
                left: 0;
                bottom: 0;
                height: 3px;
                background: #f5c04e;
                width: 100%;
                transform-origin: left
            }

            #undo i.run {
                animation: undo 10s linear forwards
            }

            @keyframes undo {
                to {
                    transform: scaleX(0)
                }
            }

            /* ночная тема: тусклее и теплее */
            html.night {
                filter: brightness(.8) sepia(.28) saturate(.85) hue-rotate(-8deg)
            }

            html.night body:after {
                opacity: .1
            }

            /* ---------- радио ---------- */
            .radio {
                margin-top: 10px;
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 12px;
                border-radius: 18px;
                background: linear-gradient(150deg,rgba(201,180,255,.12),rgba(99,220,255,.06));
                border: 1px solid var(--edge)
            }

            .rbtn {
                position: relative;
                width: 40px;
                height: 40px;
                flex: 0 0 40px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #04122b;
                background: linear-gradient(180deg,#eaf5ff,#b6dbff);
                box-shadow: 0 6px 16px rgba(63,157,251,.3)
            }

            .rbtn svg {
                width: 18px;
                height: 18px
            }

            .rbtn .i-pause {
                display: none
            }

            .radio.on .rbtn .i-play {
                display: none
            }

            .radio.on .rbtn .i-pause {
                display: block
            }

            .radio.on .rbtn {
                background: linear-gradient(180deg,#e9dcff,#b9a2ff)
            }

            .rspin {
                position: absolute;
                inset: -3px;
                border-radius: 50%;
                border: 2px solid transparent;
                border-top-color: var(--cyan);
                display: none;
                animation: sp 1s linear infinite
            }

            .radio.load .rspin {
                display: block
            }

            .rinfo {
                flex: 1;
                min-width: 0
            }

            .rinfo b {
                display: flex;
                align-items: center;
                gap: 7px;
                font-size: 13.5px
            }

            .rinfo .rst {
                display: block;
                font-size: 11.5px;
                color: var(--muted);
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis
            }

            .radio.err .rst {
                color: #ffb3b8
            }

            .req {
                display: inline-flex;
                align-items: flex-end;
                gap: 2px;
                height: 12px;
                opacity: 0;
                transition: opacity .2s
            }

            .req i {
                width: 3px;
                height: 4px;
                border-radius: 2px;
                background: #c9b4ff
            }

            .radio.on .req,#rmini .req {
                opacity: 1
            }

            .radio.on .req i,#rmini .req i {
                animation: eq 1s ease-in-out infinite
            }

            .req i:nth-child(2) {
                animation-delay: .25s!important
            }

            .req i:nth-child(3) {
                animation-delay: .5s!important
            }

            .req i:nth-child(4) {
                animation-delay: .15s!important
            }

            @keyframes eq {
                0%,100% {
                    height: 3px
                }

                50% {
                    height: 12px
                }
            }

            .rvol {
                width: 64px;
                accent-color: #c9b4ff
            }

            #aside .radio .rvol,#side .radio .rvol {
                width: 58px
            }

            #rmini {
                position: fixed;
                right: 14px;
                bottom: calc(96px + env(safe-area-inset-bottom));
                z-index: 39;
                display: none;
                align-items: center;
                gap: 8px;
                padding: 9px 12px 9px 14px;
                border-radius: 999px;
                font-size: 13px;
                font-weight: 600;
                color: var(--text);
                background: rgba(24,20,56,.9);
                border: 1px solid rgba(201,180,255,.4);
                box-shadow: 0 10px 26px rgba(0,0,0,.4);
                backdrop-filter: blur(12px)
            }

            #rmini svg {
                width: 16px;
                height: 16px;
                color: #c9b4ff
            }

            @media (max-width: 860px) {
                #rmini:not([hidden]) {
                    display:inline-flex
                }

                .more-radio .rvol {
                    width: 90px
                }
            }

            /* ---------- памятка ---------- */
            .gd-hero {
                border-radius: 24px;
                padding: 22px 24px
            }

            .gd-hero h2 {
                font-size: 22px;
                font-weight: 600;
                letter-spacing: -.03em
            }

            .gd-hero p {
                font-size: 14.5px;
                color: var(--muted);
                margin-top: 6px;
                line-height: 1.5
            }

            .rules {
                display: grid;
                grid-template-columns: repeat(3,1fr);
                gap: 12px;
                margin-top: 18px
            }

            .rule {
                border-radius: 18px;
                padding: 16px;
                background: var(--g1);
                border: 1px solid var(--edge)
            }

            .rule .n {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                font-size: 15px;
                color: #04122b;
                background: linear-gradient(180deg,#eaf5ff,#a9d4ff);
                margin-bottom: 10px
            }

            .rule b {
                display: block;
                font-size: 15px;
                font-weight: 600;
                margin-bottom: 4px
            }

            .rule span {
                font-size: 13.5px;
                color: var(--muted);
                line-height: 1.45
            }

            .gd {
                border-radius: 22px;
                margin-top: 12px;
                background: var(--g1);
                border: 1px solid var(--edge);
                overflow: hidden
            }

            .gd>summary {
                list-style: none;
                cursor: pointer;
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 16px 18px
            }

            .gd>summary::-webkit-details-marker {
                display: none
            }

            .gd>summary .ic {
                width: 40px;
                height: 40px;
                flex: 0 0 40px;
                border-radius: 13px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: rgba(99,220,255,.12);
                color: #bff0ff
            }

            .gd>summary .ic svg {
                width: 20px;
                height: 20px
            }

            .gd>summary .tt b {
                display: block;
                font-size: 16px;
                font-weight: 600;
                color: var(--text)
            }

            .gd>summary .tt i {
                display: block;
                font-style: normal;
                font-size: 13px;
                color: var(--muted);
                margin-top: 2px
            }

            .gd>summary .ch {
                margin-left: auto;
                width: 18px;
                height: 18px;
                color: var(--dim);
