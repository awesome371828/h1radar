            }

            .gd[open]>summary .ch {
                transform: rotate(90deg)
            }

            .gd .in {
                padding: 0 18px 18px
            }

            .gd .in p {
                font-size: 14px;
                line-height: 1.55;
                color: rgba(238,245,255,.88);
                margin-bottom: 10px
            }

            .yn {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 10px;
                margin: 6px 0 12px
            }

            .yn>div {
                border-radius: 16px;
                padding: 14px 16px
            }

            .yn .y {
                background: rgba(52,211,153,.07);
                border: 1px solid rgba(52,211,153,.25)
            }

            .yn .n {
                background: rgba(255,95,107,.06);
                border: 1px solid rgba(255,95,107,.22)
            }

            .yn h4 {
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 1.6px;
                text-transform: uppercase;
                margin-bottom: 8px
            }

            .yn .y h4 {
                color: #9ff0cf
            }

            .yn .n h4 {
                color: #ffb3b8
            }

            .yn ul {
                list-style: none;
                display: flex;
                flex-direction: column;
                gap: 7px
            }

            .yn li {
                font-size: 13.5px;
                line-height: 1.45;
                padding-left: 16px;
                position: relative;
                color: rgba(238,245,255,.88)
            }

            .yn li:before {
                content: "";
                position: absolute;
                left: 0;
                top: 7px;
                width: 6px;
                height: 6px;
                border-radius: 50%
            }

            .yn .y li:before {
                background: var(--ok)
            }

            .yn .n li:before {
                background: var(--bad)
            }

            .ex {
                border-radius: 14px;
                padding: 12px 14px;
                margin-top: 8px;
                background: rgba(3,10,24,.45);
                border: 1px solid var(--edge);
                font-size: 13.5px;
                line-height: 1.5
            }

            .ex q {
                display: block;
                quotes: none;
                color: var(--text);
                font-style: italic;
                margin-bottom: 5px
            }

            .ex q:before,.ex q:after {
                content: none
            }

            .ex em {
                font-style: normal;
                color: var(--muted)
            }

            .ex em b {
                color: #ffe29a;
                font-weight: 600
            }

            .steps {
                counter-reset: st;
                list-style: none;
                display: flex;
                flex-direction: column;
                gap: 8px;
                margin: 6px 0 10px
            }

            .steps li {
                counter-increment: st;
                position: relative;
                padding-left: 34px;
                font-size: 14px;
                line-height: 1.5
            }

            .steps li:before {
                content: counter(st);
                position: absolute;
                left: 0;
                top: 0;
                width: 24px;
                height: 24px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 12px;
                font-weight: 700;
                background: rgba(99,220,255,.16);
                color: #bff0ff
            }

            @media (max-width: 860px) {
                .rules {
                    grid-template-columns:1fr;
                    gap: 8px
                }

                .yn {
                    grid-template-columns: 1fr
                }

                .rule {
                    display: flex;
                    gap: 12px;
                    padding: 12px 14px
                }

                .rule .n {
                    flex: 0 0 28px;
                    width: 28px;
                    height: 28px;
                    font-size: 13px;
                    margin: 0
                }

                .gd-hero {
                    padding: 18px
                }

                .gd-hero h2 {
                    font-size: 19px
                }
            }

            /* ---------- модалка ---------- */
            #ovl {
                position: fixed;
                inset: 0;
                z-index: 60;
                background: rgba(3,8,20,.55);
                backdrop-filter: blur(4px);
                -webkit-backdrop-filter: blur(4px);
                display: none;
                align-items: center;
                justify-content: center;
                padding: 20px
            }

            #ovl.on {
                display: flex;
                animation: fd .2s
            }

            @keyframes fd {
                from {
                    opacity: 0
                }
            }

            .dlg {
                width: 100%;
                max-width: 460px;
                border-radius: 28px;
                padding: 24px;
                background: linear-gradient(160deg,rgba(18,44,86,.97),rgba(7,20,44,.98));
                border: 1px solid var(--edge2);
                box-shadow: 0 30px 80px rgba(0,0,0,.55),var(--inner);
