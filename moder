                                        it.classList.add('flash');
                                        setTimeout( () => it.classList.remove('flash'), 1600);
                                    }
                                }
                                if (d) {
                                    pop.remove();
                                    const b = $('m_list').querySelector(`[data-del="${CSS.escape(d.dataset.pdel)}"]`);
                                    if (b)
                                        b.click();
