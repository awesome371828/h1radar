                function tint(m) {
                    let ls = [];
                    try {
                        ls = (m.getStyle() || {}).layers || [];
                    } catch (e) {
                        return;
                    }
                    const set = (id, k, v) => {
                        try {
                            m.setPaintProperty(id, k, v);
                        } catch (e) {}
                    }
                    ;
                    for (const L of ls) {
                        const id = String(L.id || '')
                          , x = id.toLowerCase()
                          , t = L.type;
                        if (t === 'background')
                            set(id, 'background-color', '#04101f');
                        else if (t === 'fill') {
                            if (/water|ocean|sea|river|lake/.test(x)) {
                                set(id, 'fill-color', '#0a2f66');
                                set(id, 'fill-opacity', .92);
                            } else if (/build/.test(x)) {
                                set(id, 'fill-color', '#10264a');
                                set(id, 'fill-opacity', .5);
                            } else {
                                set(id, 'fill-color', '#061a33');
                                set(id, 'fill-opacity', .55);
                            }
                        } else if (t === 'line') {
                            if (/water|river/.test(x))
                                set(id, 'line-color', '#1a5da8');
                            else if (/motorway|trunk/.test(x))
                                set(id, 'line-color', 'rgba(140,200,255,.42)');
                            else
                                set(id, 'line-color', 'rgba(120,180,245,.17)');
                        } else if (t === 'symbol') {
                            set(id, 'text-halo-color', 'rgba(3,10,26,.88)');
                            set(id, 'text-halo-width', 1.3);
                            set(id, 'text-color', '#bcd9ff');
                        }
                    }
                }
                async function mapInit() {
