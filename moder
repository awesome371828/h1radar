                async function recStart() {
                    const mt = recMime();
                    if (mt === null) {
                        toast('Браузер не умеет записывать звук', true);
                        return;
                    }
                    let st;
                    try {
                        st = await navigator.mediaDevices.getUserMedia({
                            audio: {
                                echoCancellation: true,
                                noiseSuppression: true
                            }
                        });
                    } catch (e) {
                        toast('Нет доступа к микрофону — разреши в настройках браузера', true);
                        return;
                    }
                    const mr = new MediaRecorder(st,mt ? {
                        mimeType: mt,
                        audioBitsPerSecond: 48000
                    } : {
                        audioBitsPerSecond: 48000
                    });
                    const parts = [];
                    mr.ondataavailable = e => {
                        if (e.data && e.data.size)
                            parts.push(e.data);
                    }
                    ;
                    REC = {
                        mr,
                        st,
                        parts,
                        t0: Date.now(),
                        send: false
                    };
                    mr.onstop = async () => {
                        const r = REC;
                        REC = null;
                        r.st.getTracks().forEach(x => x.stop());
                        $('ch_in').parentElement.classList.remove('rec');
                        clearInterval(r.tt);
                        if (!r.send)
                            return;
                        const dur = (Date.now() - r.t0) / 1000;
                        if (dur < 1) {
                            toast('Слишком коротко', true);
                            return;
                        }
                        const type = (mr.mimeType || mt || 'audio/webm').split(';')[0];
                        const blob = new Blob(r.parts,{
                            type
                        });
                        try {
                            const res = await fetch('/api/mod/voice?dur=' + Math.round(dur), {
                                method: 'POST',
                                credentials: 'same-origin',
                                headers: {
                                    'Content-Type': type
                                },
                                body: blob
                            });
                            const d = await res.json();
                            if (d.error) {
                                toast(d.error, true);
                                return;
                            }
                            CH.push(d.msg);
                            CHSEQ = Math.max(CHSEQ, d.seq || 0);
                            chSeen(CHSEQ);
                            drawChat(true);
                        } catch (e) {
                            toast('Не отправилось', true);
                        }
                    }
                    ;
                    mr.start(250);
                    $('ch_in').parentElement.classList.add('rec');
                    REC.tt = setInterval( () => {
                        if (!REC)
                            return;
                        const s = (Date.now() - REC.t0) / 1000;
                        $('ch_rect').textContent = vdur(s);
                        if (s >= 120) {
                            REC.send = true;
                            REC.mr.stop();
                        }
                    }
                    , 250);
