<!DOCTYPE html>
<html lang="ru">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <meta name="theme-color" content="#061128">
        <meta name="robots" content="noindex, nofollow">
        <title>GDE.WTF · модерация</title>
        <link rel="apple-touch-icon" href="/apple-touch-icon.png">
        <link rel="manifest" href="/moder.webmanifest">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
        <meta name="apple-mobile-web-app-title" content="Модерация">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        <link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet">
        <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
        <style>
            :root {
                --void: #030814;
                --deep: #061128;
                --navy: #0b2350;
                --azure: #1a5fd0;
                --sky: #3f9dfb;
                --cyan: #63dcff;
                --text: #eef5ff;
                --muted: rgba(214,233,255,.62);
                --dim: rgba(214,233,255,.42);
                --ok: #34d399;
                --warn: #f5c04e;
                --hot: #ff9640;
                --bad: #ff5f6b;
                --air: #4ec9e8;
                --plane: #c084fc;
                --g1: rgba(255,255,255,.07);
                --g2: rgba(255,255,255,.11);
                --g3: rgba(255,255,255,.04);
                --edge: rgba(190,220,255,.16);
                --edge2: rgba(190,220,255,.28);
                --glass: linear-gradient(150deg,rgba(158,205,255,.13) 0%,rgba(9,27,58,.55) 50%,rgba(140,192,255,.10) 100%);
                --shadow: 0 20px 50px rgba(2,8,22,.5),0 2px 10px rgba(2,8,22,.3);
                --inner: inset 0 1px 0 rgba(255,255,255,.22),inset 0 -1px 0 rgba(255,255,255,.04);
                --ease: cubic-bezier(.22,.8,.3,1);
                --side: 256px;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                -webkit-tap-highlight-color: transparent
            }

            html {
                background: var(--void)
            }

            body {
                min-height: 100vh;
                color: var(--text);
                letter-spacing: -.011em;
                font-family: "Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
                -webkit-font-smoothing: antialiased;
                background: transparent;
                overflow-x: hidden
            }

            body:before {
                content: "";
                position: fixed;
                inset: 0;
                z-index: -2;
                pointer-events: none;
                background: radial-gradient(60% 40% at 18% -8%,#16438c 0%,transparent 62%), radial-gradient(50% 36% at 100% 30%,#0d3569 0%,transparent 64%), radial-gradient(60% 40% at 30% 110%,#0f2e62 0%,transparent 66%), linear-gradient(170deg,#061430 0%,#081d3e 45%,#040c1b 100%)
            }

            body:after {
                content: "";
                position: fixed;
                inset: 0;
                z-index: -1;
                pointer-events: none;
                opacity: .22;
                background: repeating-linear-gradient(0deg,rgba(255,255,255,.05) 0 1px,transparent 1px 56px), repeating-linear-gradient(90deg,rgba(255,255,255,.05) 0 1px,transparent 1px 56px);
                -webkit-mask-image: radial-gradient(80% 60% at 60% 30%,#000,transparent)
            }

            b,.num,.tab-num {
                font-variant-numeric: tabular-nums
            }

            button,input,select,textarea {
                font: inherit;
                color: inherit
            }

            button {
                cursor: pointer;
                border: 0;
                background: none
            }

            a {
                color: var(--cyan);
                text-decoration: none
            }

            ::selection {
                background: rgba(99,220,255,.3)
            }

            ::-webkit-scrollbar {
                width: 8px;
                height: 8px
            }

            ::-webkit-scrollbar-thumb {
                background: rgba(160,200,255,.16);
                border-radius: 8px
            }

            .glass {
                background: var(--glass);
                border: 1px solid var(--edge);
                box-shadow: var(--shadow),var(--inner);
                backdrop-filter: blur(24px) saturate(160%);
                -webkit-backdrop-filter: blur(24px) saturate(160%)
            }

            .mono {
                font-family: ui-monospace,"SF Mono",Menlo,monospace;
                letter-spacing: .02em
            }

            /* ---------- вход ---------- */
            #gate {
                min-height: 100vh;
                display: none;
                align-items: center;
                justify-content: center;
                padding: 24px
            }

            body.st-gate #gate {
                display: flex
            }

            .gcard {
                width: 100%;
                max-width: 420px;
                border-radius: 30px;
                padding: 34px 30px 28px;
                text-align: center
            }

            .gcard .logo {
                width: 74px;
                height: 74px;
                margin: 0 auto 18px
            }

            .gcard h1 {
                font-size: 28px;
                font-weight: 600;
                letter-spacing: -.035em;
                margin-bottom: 8px
            }

            .gcard p {
                font-size: 15px;
                line-height: 1.5;
                color: var(--muted);
                margin-bottom: 24px
            }

            .gconsent {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 9px;
                margin: 4px 0 14px;
                font-size: 12px;
                line-height: 1.4;
                color: var(--muted);
                cursor: pointer;
                text-align: left
            }

            .gconsent span {
                max-width: 250px;
                display: block;
                text-align: left
            }

            .gconsent input {
                appearance: none;
                -webkit-appearance: none;
                width: 18px;
                height: 18px;
                flex: 0 0 18px;
                margin: 0;
                border: 1.5px solid rgba(160,200,235,.55);
                border-radius: 5px;
                background: rgba(5,18,38,.6);
                position: relative;
                cursor: pointer
            }

            .gconsent input:checked {
                background: #63dcff;
                border-color: #63dcff
            }

            .gconsent input:checked:after {
                content: "";
                position: absolute;
                left: 5px;
                top: 1px;
                width: 5px;
                height: 10px;
                border: solid #04122b;
                border-width: 0 2px 2px 0;
                transform: rotate(45deg)
            }

            .gconsent a {
                color: #9fe8ff
            }

            .gcard .sm {
                font-size: 12.5px;
                color: var(--dim);
                margin-top: 16px;
                margin-bottom: 0
            }

            .btn-main {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                width: 100%;
                padding: 15px 18px;
                border-radius: 16px;
                font-size: 15.5px;
                font-weight: 600;
                color: #04122b;
                background: linear-gradient(180deg,#eaf5ff,#a9d4ff);
                box-shadow: 0 12px 30px rgba(63,157,251,.35);
                transition: transform .15s var(--ease),box-shadow .2s
            }

            .btn-main:active {
                transform: scale(.98)
            }

            .btn-main svg {
                width: 20px;
                height: 20px
            }

            .btn-ghost {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                padding: 11px 16px;
                border-radius: 13px;
                font-size: 14px;
                font-weight: 500;
                background: var(--g1);
                border: 1px solid var(--edge);
                color: var(--text);
                transition: background .15s
            }

            .btn-ghost:hover {
                background: var(--g2)
            }

            .gwait {
                display: none;
                align-items: center;
                justify-content: center;
                gap: 10px;
                margin-top: 16px;
                font-size: 13.5px;
                color: var(--muted)
            }

            .gwait.on {
                display: flex
            }

            .spin {
                width: 16px;
                height: 16px;
                border-radius: 50%;
                border: 2px solid rgba(160,200,255,.25);
                border-top-color: var(--cyan);
                animation: sp 1s linear infinite
            }

            @keyframes sp {
                to {
                    transform: rotate(360deg)
                }
            }

            /* ---------- каркас ---------- */
            #app {
                display: none
            }

            body.st-app #app {
                display: block
            }

            aside#side {
                position: fixed;
                left: 14px;
                top: 14px;
                bottom: 14px;
                width: var(--side);
                z-index: 30;
                border-radius: 26px;
                display: flex;
                flex-direction: column;
                padding: 18px 12px 12px
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 4px 10px 18px
            }

            .brand svg {
                width: 40px;
                height: 40px;
                flex: 0 0 40px
            }

            .brand .wm {
                font-size: 18px;
                letter-spacing: -.04em;
                line-height: 1
            }

            .brand .wm b {
                font-weight: 700;
                background: linear-gradient(118deg,#9fd2ff,#63dcff 46%,#c9b4ff);
                -webkit-background-clip: text;
                color: transparent
            }

            .brand .kk {
                font-size: 10.5px;
                font-weight: 700;
                letter-spacing: 2.6px;
                color: var(--dim);
                margin-top: 5px
            }

            nav#nav {
                display: flex;
                flex-direction: column;
                gap: 3px;
                flex: 1;
                overflow: auto
            }

            .nv {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 11px 12px;
                border-radius: 14px;
                font-size: 14.5px;
                font-weight: 500;
                color: var(--muted);
                text-align: left;
                width: 100%;
                transition: background .15s,color .15s;
                position: relative
            }

            .nv svg {
                width: 20px;
                height: 20px;
                flex: 0 0 20px;
                opacity: .85
            }

            .nv:hover {
                background: var(--g3);
                color: var(--text)
            }

            .nv.on {
                background: linear-gradient(180deg,rgba(234,245,255,.16),rgba(169,212,255,.08));
                color: var(--text);
                box-shadow: inset 0 1px 0 rgba(255,255,255,.18),0 0 0 1px rgba(190,220,255,.16)
            }

            .nv.on svg {
                opacity: 1;
                color: var(--cyan)
            }

            .nv .cnt {
                margin-left: auto;
                min-width: 22px;
                height: 22px;
                padding: 0 7px;
                border-radius: 999px;
                display: none;
                align-items: center;
                justify-content: center;
                font-size: 11.5px;
                font-weight: 700;
                color: #04122b;
                background: linear-gradient(180deg,#ffe29a,#f5c04e)
            }

            .nv .cnt.on {
                display: inline-flex
            }

            .me {
                margin-top: 10px;
                padding: 12px;
                border-radius: 18px;
                background: var(--g3);
                border: 1px solid var(--edge);
                display: flex;
                align-items: center;
                gap: 11px
            }

            .ava {
                width: 38px;
                height: 38px;
                flex: 0 0 38px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                font-size: 15px;
                color: #04122b;
                background: linear-gradient(160deg,#c9e6ff,#7fb9ff)
            }

            .me .nm {
                font-size: 13.5px;
                font-weight: 600;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis
            }

            .me .rl {
                font-size: 11.5px;
                color: var(--dim);
                margin-top: 2px
            }

            .me button {
                margin-left: auto;
                width: 34px;
                height: 34px;
                border-radius: 11px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--muted)
            }

            .me button:hover {
                background: var(--g2);
                color: #ffb3b8
            }

            .me button svg {
                width: 18px;
                height: 18px
            }

            main#main {
                margin-left: calc(var(--side) + 28px);
                padding: 22px 28px 60px 0;
                max-width: 1180px
            }

            .top {
                display: flex;
                align-items: flex-end;
                gap: 16px;
                margin: 6px 0 20px;
                min-height: 56px
            }

            .mbanner {
                display: flex;
                align-items: center;
                gap: 10px;
                margin: 4px 0 10px;
                padding: 9px 14px;
                border-radius: 14px;
                font-size: 13px;
                line-height: 1.4;
                color: #eaf2ff;
                background: linear-gradient(100deg,rgba(76,204,255,.16),rgba(147,61,221,.2));
                border: 1px solid rgba(170,200,255,.28)
            }

            .mbanner i {
                flex: 0 0 8px;
                height: 8px;
                border-radius: 50%;
                background: #ffb27a;
                box-shadow: 0 0 10px #ffb27a
            }

            .mbanner b {
                color: #fff
            }

            #pg-rules .crow {
                display: flex;
                justify-content: space-between;
                gap: 12px;
                align-items: baseline;
                padding: 7px 0;
                border-bottom: 1px solid rgba(255,255,255,.06);
                font-size: 13.5px
            }

            #pg-rules .crow:last-child {
                border-bottom: none
            }

            #pg-rules .crow span {
                color: var(--muted)
            }

            #pg-rules .crow b {
                font-weight: 700;
                text-align: right
            }

            .top h1 {
                font-size: 30px;
                font-weight: 600;
                letter-spacing: -.04em;
                line-height: 1.1
            }

            .top .sub {
                font-size: 13.5px;
                color: var(--muted);
                margin-top: 6px
            }

            .top .live {
                margin-left: auto;
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 12.5px;
                color: var(--dim);
                padding: 8px 12px;
                border-radius: 999px;
                background: var(--g3);
                border: 1px solid var(--edge)
            }

            .dotlive {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: var(--ok);
                box-shadow: 0 0 0 4px rgba(52,211,153,.15),0 0 10px rgba(52,211,153,.8)
            }

            .top .live.stale .dotlive {
                background: var(--warn);
                box-shadow: 0 0 0 4px rgba(245,192,78,.15)
            }

            .mhead {
                display: none
            }

            section.pg {
                display: none;
                animation: pgin .35s var(--ease)
            }

            section.pg.on {
                display: block
            }

            @keyframes pgin {
                from {
                    opacity: 0;
                    transform: translateY(8px)
                }

                to {
                    opacity: 1;
                    transform: none
                }
            }

            /* ---------- общие блоки ---------- */
            .card {
                border-radius: 24px;
                padding: 20px 22px
            }

            .grid {
                display: grid;
                gap: 14px
            }

            .g4 {
                grid-template-columns: repeat(4,1fr)
            }

            .g2 {
                grid-template-columns: 1fr 1fr
            }

            .lbl {
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 2.4px;
                color: var(--dim);
                text-transform: uppercase;
                margin: 26px 2px 12px;
                display: flex;
                align-items: center;
                gap: 12px
            }

            .lbl:after {
                content: "";
                flex: 1;
                height: 1px;
                background: linear-gradient(90deg,rgba(160,200,255,.22),transparent)
            }

            .tile {
                border-radius: 20px;
                padding: 16px 18px;
                background: var(--g1);
                border: 1px solid var(--edge);
                box-shadow: var(--inner)
            }

            .tile .k {
                font-size: 12.5px;
                color: var(--muted)
            }

            .tile .v {
                font-size: 30px;
                font-weight: 600;
                letter-spacing: -.04em;
                margin-top: 6px
            }

            .tile .h {
                font-size: 12px;
                color: var(--dim);
                margin-top: 2px
            }

            .hello {
                display: flex;
                gap: 18px;
                align-items: center;
                flex-wrap: wrap
            }

            .hello h2 {
                font-size: 24px;
                font-weight: 600;
                letter-spacing: -.035em
            }

            .hello p {
                font-size: 14px;
                color: var(--muted);
                margin-top: 5px;
                line-height: 1.45
            }

            .chips {
                display: flex;
                flex-wrap: wrap;
                gap: 7px;
                margin-top: 14px
            }

            .chip {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                padding: 7px 12px;
                border-radius: 999px;
                font-size: 12.5px;
                font-weight: 500;
                background: rgba(99,220,255,.10);
                border: 1px solid rgba(99,220,255,.22);
                color: #cfeeff
            }

            .chip svg {
                width: 14px;
                height: 14px
            }

            .cities {
                display: grid;
                grid-template-columns: repeat(5,1fr);
                gap: 10px
            }

            .city {
                border-radius: 18px;
                padding: 14px;
                background: var(--g1);
                border: 1px solid var(--edge);
                position: relative;
                overflow: hidden
            }

            .city .n {
                font-size: 14px;
                font-weight: 600
            }

            .city .s {
                font-size: 12.5px;
                margin-top: 6px;
                display: flex;
                align-items: center;
                gap: 7px;
                color: var(--muted)
            }

            .city .s i {
                width: 9px;
                height: 9px;
                border-radius: 50%;
                background: var(--ok);
                box-shadow: 0 0 10px currentColor
            }

            .city.l1 .s i {
                background: var(--warn)
            }

            .city.l2 .s i {
                background: var(--hot)
            }

            .city.l3 .s i {
                background: var(--bad)
            }

            .city.l2,.city.l3 {
                border-color: rgba(255,95,107,.35)
            }

            .cta {
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 16px 18px;
                border-radius: 20px;
                width: 100%;
                text-align: left;
                background: linear-gradient(170deg,rgba(245,192,78,.14),rgba(245,192,78,.04));
                border: 1px solid rgba(245,192,78,.3)
            }

            .cta.blue {
                background: linear-gradient(170deg,rgba(99,220,255,.12),rgba(99,220,255,.03));
                border-color: rgba(99,220,255,.28)
            }

            .cta .ic {
                width: 44px;
                height: 44px;
                flex: 0 0 44px;
                border-radius: 14px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: rgba(245,192,78,.18);
                color: #ffe29a
            }

            .cta.blue .ic {
                background: rgba(99,220,255,.16);
                color: #bff0ff
            }

            .cta .ic svg {
                width: 22px;
                height: 22px
            }

            .cta b {
                display: block;
                font-size: 15px;
                font-weight: 600;
                color: var(--text)
            }

            .cta span {
                font-size: 13px;
                color: var(--muted)
            }

            .cta .go {
                margin-left: auto;
                color: var(--muted)
            }

            /* ---------- фильтры ---------- */
            .bar {
                display: flex;
                align-items: center;
                gap: 10px;
                flex-wrap: wrap;
                margin-bottom: 16px
            }

            .seg {
                display: inline-flex;
                padding: 4px;
                border-radius: 14px;
                background: var(--g3);
                border: 1px solid var(--edge)
            }

            .seg button {
                padding: 8px 13px;
                border-radius: 10px;
                font-size: 13px;
                font-weight: 500;
                color: var(--muted);
                white-space: nowrap
            }

            .seg button.on {
                background: linear-gradient(180deg,#eaf5ff,#b6dbff);
                color: #04122b;
                font-weight: 600;
                box-shadow: 0 4px 14px rgba(63,157,251,.3)
            }

            .search {
                flex: 1;
                min-width: 200px;
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 0 14px;
                height: 44px;
                border-radius: 14px;
                background: rgba(6,18,40,.6);
                border: 1px solid var(--edge)
            }

            .search svg {
                width: 18px;
                height: 18px;
                color: var(--dim);
                flex: 0 0 18px
            }

            .search input {
                flex: 1;
                background: none;
                border: 0;
                outline: 0;
                font-size: 14.5px;
                min-width: 0
            }

            .search input::placeholder {
                color: var(--dim)
            }

            .search:focus-within {
                border-color: rgba(99,220,255,.5);
                box-shadow: 0 0 0 4px rgba(99,220,255,.1)
            }

            select.sel {
                height: 44px;
                padding: 0 36px 0 14px;
                border-radius: 14px;
                background: rgba(6,18,40,.6);
                border: 1px solid var(--edge);
                font-size: 14px;
                appearance: none;
                -webkit-appearance: none;
                background-image: linear-gradient(45deg,transparent 50%,#9fb6d6 50%),linear-gradient(135deg,#9fb6d6 50%,transparent 50%);
                background-position: calc(100% - 18px) 19px,calc(100% - 13px) 19px;
                background-size: 5px 5px;
                background-repeat: no-repeat
            }

            .count {
                font-size: 13px;
                color: var(--dim);
                margin-left: auto
            }

            /* ---------- списки ---------- */
            .list {
                display: flex;
                flex-direction: column;
                gap: 10px
            }

            .it {
                position: relative;
                display: flex;
                gap: 14px;
                align-items: flex-start;
                padding: 16px 18px 16px 20px;
                border-radius: 20px;
                background: var(--g1);
                border: 1px solid var(--edge);
                box-shadow: var(--inner);
                transition: opacity .35s,transform .35s var(--ease),max-height .4s var(--ease),margin .4s,padding .4s;
                max-height: 600px;
                overflow: hidden
            }

            .it:before {
                content: "";
                position: absolute;
                left: 0;
                top: 14px;
                bottom: 14px;
                width: 3px;
                border-radius: 0 3px 3px 0;
                background: var(--c,#9aa4b5)
            }

            .it.gone {
                opacity: 0;
                transform: translateX(30px);
                max-height: 0;
                padding-top: 0;
                padding-bottom: 0;
                margin-top: -10px
            }

            .it .body {
                flex: 1;
