                let REC = null;
                function recMime() {
                    const c = ['audio/mp4', 'audio/mp4;codecs=mp4a.40.2', 'audio/webm;codecs=opus', 'audio/webm', 'audio/ogg;codecs=opus'];
                    if (!window.MediaRecorder)
                        return null;
                    return c.find(x => {
