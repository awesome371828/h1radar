                }
            }

            .dlg h3 {
                font-size: 20px;
                font-weight: 600;
                letter-spacing: -.03em
            }

            .dlg .q {
                font-size: 14px;
                color: var(--muted);
                margin-top: 8px;
                line-height: 1.5;
                word-break: break-word
            }

            .dlg .rs {
                display: flex;
                flex-wrap: wrap;
                gap: 7px;
                margin-top: 16px
            }

            .dlg .rs button {
                padding: 8px 12px;
                border-radius: 11px;
                font-size: 13px;
                background: var(--g1);
                border: 1px solid var(--edge)
            }

            .dlg .rs button.on {
                background: rgba(99,220,255,.16);
                border-color: rgba(99,220,255,.45);
                color: #dff6ff
            }

            .dlg textarea {
                width: 100%;
                margin-top: 12px;
                min-height: 74px;
                resize: vertical;
                padding: 12px 14px;
                border-radius: 14px;
                background: rgba(3,10,24,.6);
                border: 1px solid var(--edge);
                outline: 0;
                font-size: 14px;
                line-height: 1.45
            }

            .dlg textarea:focus {
                border-color: rgba(99,220,255,.5)
            }

            .dlg .err {
                color: #ffb3b8;
                font-size: 13px;
                margin-top: 10px;
                min-height: 1px
            }

            .dlg .bt {
                display: flex;
                gap: 10px;
                margin-top: 18px
            }

            .dlg .bt button {
                flex: 1;
                padding: 14px;
                border-radius: 15px;
                font-size: 15px;
                font-weight: 600
            }

            .dlg .no {
                background: var(--g1);
                border: 1px solid var(--edge)
            }

            .dlg .yes {
                color: #fff;
                background: linear-gradient(180deg,#ff7a85,#e0505e);
                box-shadow: 0 10px 26px rgba(224,80,94,.35)
