                align-items: center;
                gap: 10px;
                padding: 13px 18px;
                border-radius: 16px;
                font-size: 14px;
                font-weight: 500;
                background: rgba(9,22,46,.94);
                border: 1px solid var(--edge2);
                box-shadow: 0 16px 40px rgba(0,0,0,.45);
                transition: all .3s var(--ease);
