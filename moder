                    if (!force && CUR === 'people' && document.activeElement === $('u_q'))
                        return;
                    if (!force && CUR === 'guide') {
                        stamp();
                        return;
                    }
                    if (!force && CUR !== 'home' && CUR !== 'chat') {
                        api('/api/mod/overview').then(o => {
                            chBadge(o.chat_seq);
                            badge('tickets', can('support') ? (o.tickets_waiting || 0) : 0);
                            badge('beta', can('beta') ? o.beta_pending : 0);
                        }
                        ).catch( () => {}
                        );
                    }
                    busy = true;
                    try {
                        await LOADERS[CUR](force);
                    } catch (e) {
                        if (e.message !== '401' && e.message !== '403')
                            console.log(e);
                    }
                    busy = false;
                }
                function lowFirst(t) {
                    t = String(t || '');
                    return t.charAt(0).toLowerCase() + t.slice(1);
                }
                function showClosed(c) {
                    if (document.getElementById('mclosed'))
                        return;
                    var st = document.createElement('style');
                    st.textContent = '#mclosed{position:fixed;inset:0;z-index:99999;display:grid;place-items:center;padding:24px;' + 'background:radial-gradient(1000px 600px at 50% -12%,#0d1f44 0%,transparent 60%),#060b18;font-family:inherit}' + '#mclosed .mcl-card{max-width:440px;width:100%;text-align:center;border-radius:24px;padding:36px 28px;' + 'background:linear-gradient(160deg,rgba(255,255,255,.08),rgba(255,255,255,.03));border:1px solid rgba(160,200,255,.14);' + 'box-shadow:0 26px 64px rgba(0,8,30,.6),inset 0 1px 0 rgba(255,255,255,.1)}' + '#mclosed .mcl-ic{width:76px;height:76px;border-radius:50%;margin:0 auto 20px;display:grid;place-items:center;' + 'color:#ff9ba3;background:rgba(255,95,107,.12);border:1px solid rgba(255,95,107,.3);box-shadow:0 0 34px rgba(255,95,107,.25)}' + '#mclosed .mcl-ic svg{width:36px;height:36px}' + '#mclosed h1{font-size:22px;font-weight:700;color:#eef5ff;margin:0 0 14px;letter-spacing:-.02em}' + '#mclosed .mcl-reason{font-size:15px;line-height:1.55;color:#dbe6ff;background:rgba(10,22,46,.5);' + 'border:1px solid rgba(160,200,255,.12);border-radius:14px;padding:14px 16px;margin:0 0 16px;white-space:pre-wrap;text-align:left}' + '#mclosed .mcl-reason.mut{color:#9fb3cf;text-align:center}' + '#mclosed .mcl-note{font-size:13px;color:#9fb3cf;line-height:1.55}' + '#mclosed .mut{color:#6c829f}' + '#mclosed .mcl-foot{margin-top:22px}' + '#mclosed .mcl-btn{font:inherit;font-size:14px;font-weight:600;color:#eef5ff;cursor:pointer;' + 'padding:10px 24px;border-radius:12px;border:1px solid rgba(160,200,255,.2);background:rgba(90,168,255,.16)}' + '#mclosed .mcl-btn:hover{background:rgba(90,168,255,.3)}';
                    document.head.appendChild(st);
                    var reason = ((c && c.text) || '').trim();
                    var since = c && c.since ? new Date(c.since * 1000).toLocaleString('ru-RU', {
                        day: 'numeric',
                        month: 'long',
                        hour: '2-digit',
                        minute: '2-digit'
                    }) : '';
                    var ov = document.createElement('div');
                    ov.id = 'mclosed';
                    ov.innerHTML = '<div class="mcl-card">' + '<div class="mcl-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4.5" y="11" width="15" height="9.5" rx="2.2"/><path d="M8 11V7.5a4 4 0 0 1 8 0V11"/><circle cx="12" cy="15.5" r="1.3" fill="currentColor" stroke="none"/></svg></div>' + '<h1>Модерка временно закрыта</h1>' + (reason ? '<div class="mcl-reason">' + esc(reason) + '</div>' : '<div class="mcl-reason mut">Администратор закрыл доступ. Подробности уточни у главного модератора.</div>') + '<div class="mcl-note">Доступ открыт только главному модератору.<br>По всем вопросам — к нему.' + (since ? '<br><br><span class="mut">Закрыто с ' + esc(since) + '</span>' : '') + '</div>' + '<div class="mcl-foot"><button class="mcl-btn" onclick="location.reload()">Обновить</button></div></div>';
                    try {
                        clearInterval(TICK);
                    } catch (e) {}
                    document.body.appendChild(ov);
                }
                async function boot() {
                    let d;
                    try {
                        d = await (await fetch('/api/mod/me?_t=' + Date.now(), {
                            cache: 'no-store',
                            credentials: 'same-origin'
                        })).json();
                    } catch (e) {
                        showGate();
                        toast('Нет связи с сервером', true);
                        return;
                    }
                    TGL = !!d.tg_login;
                    MAXL = !!d.max;
                    const le = (location.search.match(/login_err=(\w+)/) || [])[1];
                    if (le) {
                        history.replaceState(null, '', location.pathname + location.hash);
                        setTimeout( () => {
                            const m = LOGIN_ERR[le] || 'Не получилось войти';
                            const e = $('g_sm');
                            if (e) {
                                e.textContent = m;
                                e.style.color = '#ffb3b8';
                            }
                            toast(m, true);
                        }
                        , 200);
                    }
                    if (!d.auth) {
                        showGate(false);
                        const m = (location.hash.match(/login=([\w-]+)/) || [])[1] || nonce();
                        if (m)
                            startPoll(m);
                        return;
                    }
                    if (!d.mod) {
                        showGate(true);
                        return;
                    }
                    if (d.closed) {
                        showClosed(d.closed);
                        return;
                    }
                    ME = d;
                    window.SCOPED = (ME.scope !== null && ME.scope !== undefined);
                    document.body.className = 'st-app' + (SCOPED ? ' scoped' : '');
                    const n = ME.name || '—';
                    $('me_n').textContent = n;
                    $('me_a').textContent = $('me_a2').textContent = $('h_ava').textContent = initials(n);
                    $('me_r').textContent = ME.role ? ME.role.label : (ME.admin ? 'администратор' : 'модератор');
                    applyMyBg();
                    try {
                        applyTeamTheme();
                    } catch (e) {}
                    ambGate();
                    if (ME.banner && ME.banner.text) {
                        const left = ME.banner.until ? Math.max(0, Math.ceil((ME.banner.until * 1000 - Date.now()) / 86400000)) : 0;
                        const w = left > 0 ? ('В течение ' + left + ' ' + (left % 10 === 1 && left % 100 !== 11 ? 'дня' : 'дней') + ' ') : '';
                        $('mbanner_t').innerHTML = '<b>' + esc(w ? w + lowFirst(ME.banner.text) : ME.banner.text) + '</b>';
                        $('mbanner').style.display = 'flex';
                    }
                    const sel = $('f_city');
                    sel.innerHTML = '<option value="">Все города</option>' + (ME.cities || []).map(c => `<option value="${esc(c.id)}">${esc(c.name)}</option>`).join('');
                    if (SCOPED) {
                        sel.style.display = 'none';
                        sel.value = ME.scope || '';
                        const fx = $('f_city_fixed');
                        if (fx) {
                            fx.style.display = 'inline-flex';
                            fx.textContent = ME.scope ? ('Мой город · ' + cityName(ME.scope)) : 'Город не назначен';
                        }
                    }
                    buildNav();
                    const toProf = e => {
                        if (e.target.closest('#logout'))
                            return;
                        go('profile');
                    }
                    ;
                    document.querySelector('#side .me').onclick = toProf;
                    $('me_a2').onclick = toProf;
                    document.querySelector('#side .me').style.cursor = $('me_a2').style.cursor = 'pointer';
                    go((location.hash || '').replace('#', '').split('=')[0] || 'home');
                    if ((ME.chief || ME.admin) && CUR !== 'apply') {
                        try {
                            loadApplies();
                        } catch (e) {}
                    }
                    if (can('beta') && CUR !== 'home') {
                        try {
                            const o = await api('/api/mod/overview');
                            badge('beta', o.beta_pending);
                        } catch (e) {}
                    }
                    clearInterval(TICK);
                    TICK = setInterval( () => {
                        liveTxt();
                        if (Date.now() - LAST > 15000)
                            load(false);
                    }
                    , 1000);
                }
                window.addEventListener('hashchange', () => {
                    const h = location.hash.replace('#', '');
                    if (ME && h && h !== CUR && SECS.some(s => s.id === h))
                        go(h);
                }
                );
                document.addEventListener('visibilitychange', () => {
                    if (!document.hidden && ME)
                        load(false);
                }
                );
                boot();
            }
            )();
        </script>
    </body>
</html>
