<!DOCTYPE html>
<html lang="ru">
<head><script>
(function(){
  var had=false; try{ had=!!sessionStorage.getItem('__telegram__initParams'); }catch(e){}
  if(!/tgWebApp(Data|Version|Platform)/.test(location.hash)&&!had) return;
  document.write('<scr'+'ipt src="https://telegram.org/js/telegram-web-app.js"></scr'+'ipt>');
  var K='tgapp_tok',OFF='tgapp_off',tok=null,off=false;
  try{ tok=sessionStorage.getItem(K); off=!!sessionStorage.getItem(OFF); }catch(e){}
  var of=window.fetch.bind(window);
  window.fetch=function(u,o){
    try{
      var url=typeof u==='string'?u:((u&&u.url)||'');
      if(url.indexOf('/api/logout')>=0){ tok=null; off=true; try{ sessionStorage.removeItem(K); sessionStorage.setItem(OFF,'1'); }catch(e){} }
      else if(tok&&(url.charAt(0)==='/'||url.indexOf(location.origin)===0)){
        o=Object.assign({},o||{}); var h=new Headers(o.headers||{}); if(!h.has('Authorization')) h.set('Authorization','Bearer '+tok); o.headers=h; }
    }catch(e){}
    var isMark=(typeof u==='string'?u:((u&&u.url)||'')).indexOf('/api/mark')>=0&&o&&o.method==='POST';
    var pr=of(u,o);
    if(isMark) pr.then(function(r){ r.clone().json().then(function(d){ try{ if(d&&d.ok) Telegram.WebApp.HapticFeedback.notificationOccurred('success'); }catch(e){} }).catch(function(){}); }).catch(function(){});
    return pr;
  };
  function W(){ return window.Telegram&&Telegram.WebApp; }
  function go(u){ var w=W(); try{ if(/^https?:\/\/(t\.me|telegram\.me)\//.test(u)) w.openTelegramLink(u); else w.openLink(u); }catch(e){ location.href=u; } }
  window.open=function(u){ go(u); return null; };
  addEventListener('DOMContentLoaded',function(){
    var w=W(); if(!w||!w.initData) return;
    document.documentElement.classList.add('tgapp');
    try{ w.ready(); w.expand(); w.setHeaderColor('#0a1324'); w.setBackgroundColor('#0a1324'); if(w.disableVerticalSwipes) w.disableVerticalSwipes(); }catch(e){}
    document.addEventListener('click',function(e){
      var a=e.target.closest&&e.target.closest('a[href]'); if(!a) return;
      var h=a.href||''; if(h.indexOf(location.origin)===0||h.charAt(0)==='#'||!/^https?:/.test(h)) return;
      e.preventDefault(); go(h);
    },true);
    // отличия Mini App от сайта: свой вид, карточка про сайт вместо рекламы ГРОЗЫ, полный экран
    var st=document.createElement('style');
    st.textContent='.tgapp #pwa,.tgapp #installBtn,.tgapp #pwa_btn,.tgapp .pwa,.tgapp #grzg{display:none!important}';
    document.head.appendChild(st);
    function siteCard(){
      var g=document.getElementById('grzg'); if(!g||document.getElementById('tgsitecard')) return;
      var ic=function(d){ return '<i><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'+d+'</svg></i>'; };
      var c=document.createElement('div'); c.className='sgroup plusg on'; c.id='tgsitecard';
      c.innerHTML='<div class="plhead"><span class="plbadge">GDE<b>.WTF</b></span><b style="font-size:12.5px;font-weight:600;color:var(--muted)">полная версия</b></div>'
        +'<div class="srow cap"><span>В Telegram лёгкий режим. Всё остальное работает на сайте.</span></div>'
        +'<ul class="plperks">'
        +'<li>'+ic('<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>')+'История и аналитика по районам, ГРОЗА</li>'
        +'<li>'+ic('<path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0"/>')+'Уведомления о тревоге в твоём городе</li>'
        +'<li>'+ic('<path d="M3 11 12 3l9 8M5 10v10h14V10"/>')+'Значок на экране «Домой» — обстановка в один тап</li>'
        +'</ul>'
        +'<div class="plbuy"><button class="pbtn" id="tgsite_go" style="width:100%">Открыть сайт</button></div>';
      g.parentNode.insertBefore(c,g);
      document.getElementById('tgsite_go').onclick=function(){
        of('/api/auth/tgapp/site',{method:'POST',credentials:'same-origin',headers:tok?{Authorization:'Bearer '+tok}:{}}).then(function(r){return r.json()})
          .then(function(d){ go(d&&d.link?d.link:location.origin+'/?radar=1'); }).catch(function(){ go(location.origin+'/?radar=1'); });
      };
    }
    siteCard(); setTimeout(siteCard,1500);
    // полный экран: Telegram рисует свои кнопки сверху, поэтому отступы берём из его переменных
    var fsDone=false;
    function fsFix(){
      if(fsDone) return; fsDone=true;
      var top='(max(env(safe-area-inset-top),var(--tg-safe-area-inset-top,0px)) + var(--tg-content-safe-area-inset-top,0px))';
      var bot='max(env(safe-area-inset-bottom),var(--tg-safe-area-inset-bottom,0px))';
      document.querySelectorAll('style').forEach(function(s){
        var x=s.textContent; if(x.indexOf('safe-area-inset')<0) return;
        s.textContent=x.split('env(safe-area-inset-top)').join(top).split('env(safe-area-inset-bottom)').join(bot);
      });
    }
    try{
      if(w.isVersionAtLeast&&w.isVersionAtLeast('8.0')&&w.requestFullscreen){
        w.onEvent('fullscreenChanged',function(){ if(w.isFullscreen) fsFix(); });
        w.requestFullscreen(); if(w.isFullscreen) fsFix();
      }
    }catch(e){}
    if(off) return;
    of('/api/auth/tgapp',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({initData:w.initData})})
      .then(function(r){return r.json()}).then(function(d){
        if(d&&d.ok&&d.token){ tok=d.token; try{ sessionStorage.setItem(K,tok); }catch(e){}
          var done=false; try{ done=!!sessionStorage.getItem('tgapp_rl'); sessionStorage.setItem('tgapp_rl','1'); }catch(e){}
          if(d.fresh&&!done) location.reload(); }
      }).catch(function(){});
  });
})();
</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="GDE.WTF">
<meta name="theme-color" content="#061128">
<link rel="manifest" href="/manifest.json">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<title>Ростов-на-Дону · монитор дронов</title>
<link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
<style>
  /* ======================================================================
     GDE.WTF — Liquid Glass
     Глубокая сине-голубая палитра, текучие градиенты, стеклянные панели.
     ====================================================================== */
  :root{
    /* фон: midnight -> navy -> azure -> cyan */
    --void:#030814; --deep:#061128; --navy:#0b2350; --azure:#1a5fd0;
    --sky:#3f9dfb; --cyan:#63dcff; --ice:#d6e9ff;

    --bg:var(--void);
    --text:#eef5ff; --muted:rgba(214,233,255,.64); --dim:rgba(214,233,255,.46);
    --accent:#5aa8ff; --accent-2:#63dcff;

    /* данные — не трогаем, они читаются на карте */
    --ok:#34d399; --warn:#f5c04e; --hot:#ff9640; --bad:#ff5f6b; --air:#4ec9e8;
    --plane:#c084fc;

    /* стекло */
    --g1:rgba(255,255,255,.10);   /* базовая заливка панели */
    --g2:rgba(255,255,255,.16);   /* приподнятая */
    --g3:rgba(255,255,255,.05);   /* утопленная */
    --edge:rgba(255,255,255,.20);
    --edge-soft:rgba(255,255,255,.10);
    --blur:26px;
    --glass:linear-gradient(135deg,rgba(158,205,255,.20) 0%,
            rgba(9,27,58,.58) 46%,rgba(140,192,255,.16) 100%);
    --glass-solid:linear-gradient(160deg,rgba(16,44,86,.88) 0%,
            rgba(7,20,44,.93) 100%);
    --shadow:0 20px 50px rgba(2,8,22,.55),0 2px 10px rgba(2,8,22,.35);
    --inner:inset 0 1px 0 rgba(255,255,255,.30),
            inset 0 -1px 0 rgba(255,255,255,.06);
    --glow:0 0 34px rgba(63,157,251,.30);

    --rs:16px; --rm:22px; --rl:30px;
    --pane:rgba(255,255,255,.09);
    --line:rgba(255,255,255,.12); --line-2:rgba(255,255,255,.22);
    --surface:rgba(255,255,255,.07); --surface-2:rgba(255,255,255,.09);
    --raise:rgba(255,255,255,.15);
    --ease:cubic-bezier(.22,.8,.3,1);
  }
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{height:100%}
  body{overscroll-behavior:none;background:var(--void);color:var(--text);
       display:flex;flex-direction:column;overflow:hidden;letter-spacing:-.008em;
       font-family:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
       -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
  b,.num,#settings .srow b,.stat b{font-variant-numeric:tabular-nums}
  ::-webkit-scrollbar{width:7px;height:7px}
  ::-webkit-scrollbar-thumb{background:rgba(255,255,255,.14);border-radius:8px}
  ::-webkit-scrollbar-thumb:hover{background:rgba(255,255,255,.26)}
  ::-webkit-scrollbar-track{background:transparent}

  /* ---------- жидкий фон ---------- */
  #aurora{position:fixed;inset:-25%;z-index:0;pointer-events:none;
    background:
      radial-gradient(52% 44% at 22% 18%,rgba(26,95,208,.55) 0%,transparent 62%),
      radial-gradient(46% 40% at 82% 26%,rgba(99,220,255,.26) 0%,transparent 64%),
      radial-gradient(60% 52% at 66% 84%,rgba(11,35,80,.9) 0%,transparent 66%),
      radial-gradient(40% 36% at 12% 82%,rgba(63,157,251,.22) 0%,transparent 66%),
      var(--void);
    filter:blur(28px);animation:flow 34s ease-in-out infinite alternate}
  @keyframes flow{
    0%{transform:translate3d(0,0,0) scale(1)}
    50%{transform:translate3d(2.5%,-2%,0) scale(1.07)}
    100%{transform:translate3d(-2%,2.5%,0) scale(1.03)}}
  @media (prefers-reduced-motion:reduce){#aurora{animation:none}}

  /* ---------- стекло: миксин через утилитарный класс ---------- */
  .gs{position:relative;background:var(--glass);
      backdrop-filter:blur(var(--blur)) saturate(175%);
      -webkit-backdrop-filter:blur(var(--blur)) saturate(175%);
      border:1px solid transparent;box-shadow:var(--shadow),var(--inner)}
  /* радужная кромка-линза */
  .gs:after,#bar:after,#side:after,#replayHud:after,
  #tabs:after,#sheet:after,#toast:after,#settings .sgroup:after,.gsteps:after,
  #pickhint:after,.uidchip:after,#alarm:after{
    content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;
    background:linear-gradient(135deg,rgba(255,255,255,.55) 0%,
      rgba(140,205,255,.20) 28%,rgba(255,255,255,0) 52%,
      rgba(170,150,255,.18) 78%,rgba(255,255,255,.34) 100%);
    -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
    -webkit-mask-composite:xor;mask:linear-gradient(#000 0 0) content-box,
    linear-gradient(#000 0 0);mask-composite:exclude;pointer-events:none;z-index:2}

  /* ---------- шапка ---------- */
  #bar{position:fixed;top:14px;left:16px;right:16px;z-index:12;
       display:flex;align-items:center;gap:10px;height:58px;padding:0 10px 0 18px;
       border-radius:var(--rm);border:1px solid transparent;
       background:var(--glass);backdrop-filter:blur(var(--blur)) saturate(175%);
       -webkit-backdrop-filter:blur(var(--blur)) saturate(175%);
       box-shadow:var(--shadow),var(--inner)}
  #brand{display:inline-flex;align-items:center;gap:10px;flex-shrink:0;font-size:13px;
         font-weight:600;letter-spacing:2.6px;color:var(--text);position:relative;z-index:3}
  #brand .lg{display:none;width:28px;height:28px;flex-shrink:0;
         filter:drop-shadow(0 0 10px rgba(99,220,255,.5))}
  .live{width:7px;height:7px;border-radius:50%;background:var(--accent-2);flex-shrink:0;
        box-shadow:0 0 0 4px rgba(99,220,255,.16),0 0 14px rgba(99,220,255,.9);
        animation:pulse 2.6s infinite}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
  .sep{width:1px;height:22px;background:var(--edge-soft);flex-shrink:0;border-radius:1px}

  .seg{position:relative;z-index:3;display:flex;gap:3px;border-radius:999px;padding:4px;
       background:rgba(255,255,255,.06);border:1px solid var(--edge-soft);
       flex-shrink:0;backdrop-filter:blur(10px)}
  .seg button{background:transparent;border:0;color:var(--muted);font-family:inherit;
       font-size:12.5px;padding:6px 14px;border-radius:999px;cursor:pointer;
       transition:.32s var(--ease);white-space:nowrap;display:inline-flex;
       align-items:center;gap:7px;letter-spacing:0}
  .seg button:hover{color:var(--text)}
  .seg button.on{color:#06142e;font-weight:600;
       background:linear-gradient(180deg,#eaf4ff,#b9dcff);
       box-shadow:0 4px 14px rgba(99,180,255,.35),inset 0 1px 0 rgba(255,255,255,.9)}
  #modesw button i{width:6px;height:6px;border-radius:50%;background:currentColor;
       flex-shrink:0;opacity:.45;transition:.3s}
  #modesw button.on i{opacity:1;background:#1a5fd0}
  #histf{display:none}
  #histf.show{display:flex}

  #alarm{position:relative;z-index:3;display:inline-flex;align-items:center;gap:9px;
         padding:8px 15px;min-width:0;border-radius:999px;font-size:13px;
         background:rgba(255,255,255,.08);border:1px solid transparent;
         backdrop-filter:blur(12px);
         box-shadow:inset 0 1px 0 rgba(255,255,255,.22);
         transition:background .5s var(--ease),box-shadow .5s var(--ease)}
  #alarm .dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;background:var(--ok);
         box-shadow:0 0 0 4px rgba(52,211,153,.14),0 0 12px rgba(52,211,153,.7)}
  #alarm b{font-size:13px;font-weight:600;white-space:nowrap;letter-spacing:-.01em}
  #alarm .where{color:var(--muted);font-size:12px;max-width:26vw;overflow:hidden;
         text-overflow:ellipsis;white-space:nowrap}
  #alarm.l1{background:rgba(245,192,78,.14)}
  #alarm.l1 .dot{background:var(--warn);box-shadow:0 0 0 4px rgba(245,192,78,.16),
         0 0 12px rgba(245,192,78,.8)}
  #alarm.l1 b{color:#ffd980}
  #alarm.l2{background:rgba(255,150,64,.16)}
  #alarm.l2 .dot{background:var(--hot);box-shadow:0 0 0 4px rgba(255,150,64,.18),
         0 0 14px rgba(255,150,64,.85)}
  #alarm.l2 b{color:#ffb578}
  #alarm.l3{background:rgba(255,95,107,.20);
         box-shadow:inset 0 1px 0 rgba(255,255,255,.22),0 0 26px rgba(255,95,107,.30)}
  #alarm.l3 .dot{background:var(--bad);animation:pulse 1s infinite;
         box-shadow:0 0 0 4px rgba(255,95,107,.2),0 0 16px rgba(255,95,107,.9)}
  #alarm.l3 b{color:#ff98a3}
  #alarm.nodata{background:rgba(255,255,255,.06)}
  #alarm.nodata .dot{background:#7c869a;box-shadow:none}
  #alarm.nodata b{color:#aeb9c9}

  .stat{position:relative;z-index:3;display:inline-flex;align-items:baseline;gap:7px;
        font-size:11.5px;color:var(--muted);white-space:nowrap;flex-shrink:0;
        margin-left:auto}
  .stat b{color:var(--text);font-size:14px;font-weight:600}
  .iconb{position:relative;z-index:3;margin-left:12px;display:inline-flex;
        align-items:center;justify-content:center;width:38px;height:38px;flex-shrink:0;
        background:rgba(255,255,255,.10);border:1px solid var(--edge-soft);
        color:var(--ice);border-radius:50%;cursor:pointer;transition:.3s var(--ease);
        box-shadow:inset 0 1px 0 rgba(255,255,255,.28)}
  .iconb:hover{background:rgba(255,255,255,.18);box-shadow:inset 0 1px 0
        rgba(255,255,255,.4),0 0 20px rgba(99,220,255,.35)}
  .iconb svg{width:18px;height:18px}
  #geobtn{margin-left:12px;flex-shrink:0}
  #geobtn.busy{color:var(--accent-2);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.4),0 0 22px rgba(99,220,255,.5)}
  #geobtn.busy svg{animation:geosp 1s linear infinite}
  @keyframes geosp{0%{opacity:1}50%{opacity:.35}100%{opacity:1}}
  #geobtn.on{color:var(--accent-2)}

  /* ---------- раскладка ---------- */
  main{display:flex;flex:1;min-height:0;position:relative;z-index:1}
  #map{flex:1;position:relative}
  #side{position:fixed;right:16px;top:86px;bottom:16px;width:352px;z-index:9;
        display:flex;flex-direction:column;overflow:hidden;
        border-radius:var(--rl);border:1px solid transparent;
        background:linear-gradient(160deg,rgba(24,58,110,.80) 0%,
          rgba(8,22,48,.88) 100%);
        backdrop-filter:blur(30px) saturate(170%);
        -webkit-backdrop-filter:blur(30px) saturate(170%);
        box-shadow:var(--shadow),var(--inner)}
  #topd{position:relative;z-index:3;padding:18px 14px;max-height:34vh;overflow-y:auto;
        border-bottom:1px solid var(--edge-soft)}
  #feed{position:relative;z-index:3;flex:1;overflow-y:auto;padding:18px 14px}
  #topd h3,#feed h3{font-size:10px;color:var(--dim);text-transform:uppercase;
        letter-spacing:1.4px;font-weight:600;margin:0 6px 12px}

  .drow{position:relative;display:flex;align-items:center;justify-content:space-between;
        gap:10px;font-size:13px;padding:9px 11px;border-radius:14px;cursor:pointer;
        transition:.3s var(--ease);overflow:hidden;color:var(--muted)}
  .drow:hover{background:rgba(255,255,255,.09);color:var(--text)}
  .drow span,.drow b{position:relative;z-index:1}
  .drow b{color:var(--text);font-weight:600;font-size:13px}
  .drow .bar{position:absolute;left:0;top:0;bottom:0;z-index:0;border-radius:14px;
        background:linear-gradient(90deg,rgba(90,168,255,.34),rgba(99,220,255,.04))}

  .ev{position:relative;border-radius:18px;padding:12px 14px 12px 16px;margin-bottom:9px;
      font-size:12.5px;cursor:pointer;overflow:hidden;
      background:rgba(255,255,255,.06);border:1px solid var(--edge-soft);
      transition:.3s var(--ease)}
  .ev:before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;
      background:var(--kc,var(--edge));box-shadow:0 0 12px var(--kc,transparent)}
  .ev:hover{background:rgba(255,255,255,.12);border-color:var(--edge);
      transform:translateY(-1px)}
  .ev .top{display:flex;gap:9px;align-items:center;margin-bottom:5px;flex-wrap:wrap}
  .dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
  .ev .dd{font-weight:600;font-size:12.5px}
  .ev .tm{margin-left:auto;color:var(--dim);font-size:11px}
  .ev .st{color:var(--accent-2);font-size:10.5px;letter-spacing:.2px}
  .ev .tx{color:rgba(214,233,255,.72);line-height:1.5}
  .ev a{color:var(--dim);text-decoration:none;font-size:11px;
      display:inline-block;margin-top:7px;transition:.2s}
  .ev a:hover{color:var(--accent-2)}

  /* ---------- карта: легенда, плашки ---------- */
  #quiet{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);z-index:4;
      padding:18px 26px;display:none;pointer-events:none;text-align:center;
      border-radius:var(--rm);background:linear-gradient(150deg,
        rgba(52,211,153,.16),rgba(9,27,58,.6) 55%,rgba(52,211,153,.10));
      border:1px solid rgba(52,211,153,.5);
      backdrop-filter:blur(var(--blur)) saturate(175%);
      -webkit-backdrop-filter:blur(var(--blur)) saturate(175%);
      box-shadow:0 20px 50px rgba(2,8,22,.5),inset 0 1px 0 rgba(255,255,255,.22),
      0 0 34px rgba(52,211,153,.26)}
  #quiet b{display:block;font-size:15px;font-weight:600;color:#6ee7b7;
      letter-spacing:-.015em;margin-bottom:5px}
  #quiet span{font-size:12px;color:var(--muted)}
  /* объявление админа — на месте «всё тихо» */
  #notice{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);z-index:5;
      width:min(88vw,380px);padding:18px 22px 16px;text-align:center;border-radius:var(--rm);
      --nc:#f5c04e;--nr:245,192,78;
      background:linear-gradient(150deg,rgba(var(--nr),.20),rgba(9,27,58,.72) 55%,rgba(var(--nr),.12));
      border:1px solid rgba(var(--nr),.6);
      backdrop-filter:blur(var(--blur)) saturate(175%);-webkit-backdrop-filter:blur(var(--blur)) saturate(175%);
      box-shadow:0 20px 50px rgba(2,8,22,.5),inset 0 1px 0 rgba(255,255,255,.22),0 0 40px rgba(var(--nr),.3)}
  #notice.l2,#noticep.l2{--nc:#ff9640;--nr:255,150,64}
  #notice.l3,#noticep.l3{--nc:#ff5f6b;--nr:255,95,107}
