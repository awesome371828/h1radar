// ================= навигатор =================
// Ведём пешком по построенному маршруту: следим за геопозицией, считаем,
// где человек на линии маршрута, подсказываем следующий поворот, при
// уходе с маршрута перестраиваем. Всё считается в браузере; сервер
// нужен только чтобы построить или перестроить маршрут.
let ROUTE=null, NAV=null;
const MOD={'left':'налево','right':'направо','slight left':'левее','slight right':'правее',
  'sharp left':'резко налево','sharp right':'резко направо','straight':'прямо','uturn':'развернитесь'};
const MOD_DEG={'left':-90,'right':90,'slight left':-45,'slight right':45,'sharp left':-135,
  'sharp right':135,'uturn':180,'straight':0};
function routePrep(it,coords,steps){
  const lat0=coords[0][1], k=Math.cos(lat0*Math.PI/180);
  const P=(lon,lat)=>[lon*111320*k, lat*110540];
  const xy=coords.map(c=>P(c[0],c[1])), cum=[0];
  for(let i=1;i<xy.length;i++) cum.push(cum[i-1]+Math.hypot(xy[i][0]-xy[i-1][0],xy[i][1]-xy[i-1][1]));
  const st=(steps||[]).map(s=>{ const p=P(s.loc[0],s.loc[1]); let bi=0,bd=1e18;
    xy.forEach((q,i)=>{ const d=(q[0]-p[0])**2+(q[1]-p[1])**2; if(d<bd){bd=d;bi=i;} });
    return Object.assign({},s,{at:cum[bi]}); }).filter(s=>s.type!=='depart');
  return {it,coords,P,xy,cum,total:cum[cum.length-1],steps:st};
}
function routeProject(R,lon,lat,prev){
  const p=R.P(lon,lat); let best=null;
  for(let pass=0;pass<2&&!best;pass++){
    for(let i=1;i<R.xy.length;i++){
      if(pass===0 && R.cum[i]<prev-30) continue;       // не прыгаем назад по петлям
      const a=R.xy[i-1], b=R.xy[i], dx=b[0]-a[0], dy=b[1]-a[1], L=dx*dx+dy*dy;
      let t=L?((p[0]-a[0])*dx+(p[1]-a[1])*dy)/L:0; t=Math.max(0,Math.min(1,t));
      const off=Math.hypot(p[0]-(a[0]+t*dx),p[1]-(a[1]+t*dy));
      if(!best||off<best.off) best={off,along:R.cum[i-1]+t*Math.sqrt(L),i,t};
    }
  }
  return best;
}
function stepDo(s){
  if(!s) return 'Идите к укрытию';
  if(s.type==='arrive') return 'Укрытие';
  if(s.type==='roundabout'||s.type==='rotary') return 'Через круг'+(MOD[s.mod]?', держитесь '+MOD[s.mod]:'');
  if(s.mod==='uturn') return 'Развернитесь';
  if(!MOD[s.mod]||s.mod==='straight') return 'Продолжайте прямо';
  return 'Поверните '+MOD[s.mod];
}
function fmtIn(m){ m=Math.max(0,m); return m<15?'Сейчас':'Через '+(m<100?Math.round(m/10)*10:Math.round(m/50)*50)+' м'; }
