let SH=null, shOn=false;
function shFmt(m){ return m<1000 ? Math.round(m/10)*10+' м' : (m/1000).toFixed(1).replace('.',',')+' км'; }
function shDist(a,b,c,d){ const R=6371000,r=Math.PI/180,x=(c-a)*r,y=(d-b)*r;
  const h=Math.sin(x/2)**2+Math.cos(a*r)*Math.cos(c*r)*Math.sin(y/2)**2;
  return 2*R*Math.asin(Math.sqrt(h)); }
function shRoute(it,me){
  return me ? 'https://yandex.ru/maps/?rtext='+me.lat+','+me.lon+'~'+it.lat+','+it.lon+'&rtt=pd'
            : 'https://yandex.ru/maps/?pt='+it.lon+','+it.lat+'&z=17&l=map';
}
function shCard(it,me){
