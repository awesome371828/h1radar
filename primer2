function apply(){
  const now=Date.now()/1000;
  const winSec=liveMode?LIVE_WIN:(hours||24)*3600;
  const evs=all.filter(e=>e.ts>=now-winSec);
  // в лайве показываем только атаки, которые ещё идут; маркер взрыва —
  // только если последний реальный взрыв моложе 20 минут (boom_ts),
  // иначе болтовня в районе вечно продлевает «взрыв»
  const atk=liveMode?attacks.filter(a=>a.end>=now-LIVE_WIN
    &&(!a.explosion||(a.boom_ts||a.end)>=now-LIVE_WIN)):attacks;
  // доклад = событие с весом; вопросы («центр тихо?») и отбой на карту не идут
  const rep=evs.filter(e=>e.w===undefined||e.w>0.3);
  const dots=rep.filter(e=>e.ts>=now-DOT_TTL && e.lon!=null);
  const feat=e=>({type:'Feature',geometry:{type:'Point',coordinates:[e.lon,e.lat]},
    properties:{kind:e.kind,district:e.district,date:e.date,text:e.text,link:e.link,
                street:e.street||''}});
  // --- карта: только если карта и источники готовы ---
  const S=n=>map&&map.getSource(n);
  if(S('dots')){
    S('dots').setData({type:'FeatureCollection',features:dots.map(feat)});
    S('heat').setData({type:'FeatureCollection',features:rep.filter(e=>e.lon!=null).map(feat)});
    S('zones').setData({type:'FeatureCollection',features:atk.map(a=>({
      type:'Feature',geometry:{type:'Polygon',coordinates:a.circle},properties:{aid:a.id}}))});
    const trs=atk.filter(a=>a.trajectory);
    S('traj').setData({type:'FeatureCollection',features:trs.map(a=>({
      type:'Feature',geometry:{type:'LineString',coordinates:a.trajectory.path},
      properties:{dom:a.dom}}))});
    S('arrow').setData({type:'FeatureCollection',features:trs.map(a=>({
      type:'Feature',geometry:{type:'Polygon',coordinates:a.trajectory.arrow},
      properties:{dom:a.dom}}))});
    syncExpl(atk);
  }
  // --- UI: обновляется всегда, даже если карта не загрузилась ---
  document.getElementById('s_dot').textContent=dots.length;
  const sd2=document.getElementById('s_dot2'); if(sd2) sd2.textContent=dots.length;
  const h24=all.filter(e=>e.ts>=now-(liveMode?LIVE_WIN:86400));
  document.getElementById('s_h24').textContent=h24.length;
  document.getElementById('s_atk').textContent=atk.length;
  const qz=document.getElementById('quiet');
  QUIET_NOW=(liveMode&&rep.length===0);
  if(qz) qz.style.display='none';          // статус «тихо» живёт в шапке, центр карты свободен
  const alc=document.getElementById('alarm');
  if(alc) alc.title=QUIET_NOW?'Сейчас тревог нет — за последние 20 минут в городе ничего':'';
  noticeDraw();
  document.getElementById('s_k0').textContent=h24.filter(e=>e.kind==='Взрыв').length;
  document.getElementById('s_k1').textContent=h24.filter(e=>e.kind==='ПВО').length;
  document.getElementById('s_k2').textContent=h24.filter(e=>e.kind==='Гул дронов').length;
  document.getElementById('s_k3').textContent=h24.filter(e=>e.kind==='Вертолёты').length;
  document.getElementById('s_k4').textContent=h24.filter(e=>e.kind==='Самолёты').length;
  const g5=document.getElementById('s_k5'), g6=document.getElementById('s_k6');
  if(g5) g5.textContent=h24.filter(e=>e.kind==='Слышно'||e.kind==='Отметка').length;
  if(g6) g6.textContent=h24.filter(e=>e.kind==='Отбой').length;
  const byd={};
  h24.filter(e=>e.w===undefined||e.w>0.3)
     .forEach(e=>byd[e.district]=(byd[e.district]||0)+1);
  const top=Object.entries(byd).sort((a,b)=>b[1]-a[1]).slice(0,10);
  const dmax=top.length?top[0][1]:1;
  document.getElementById('dlist').innerHTML=top.map(([d,n])=>{
    const first=rep.find(e=>e.district===d&&e.lon!=null);
    const w=Math.max(6,Math.round(100*n/dmax));
    const go=first?`onclick="flyFrom(${first.lon},${first.lat})"`:'';
    return `<div class="drow" ${go}>`+
      `<span class="bar" style="width:${w}%"></span>`+
      `<span>${esc(d)}</span><b>${n}</b>`+
      `<span class="del" title="Убрать район целиком"`+
      ` onclick="event.stopPropagation();delDistrict('${esc(d)}')">&times;</span>`+
      `</div>`;
  }).join('')||'<div style="color:var(--muted);font-size:12px">пока пусто</div>';
  updateDrone(now);
  const feed=evs.filter(e=>e.kind!=='Вопрос').slice(0,70);  // свежие первыми
  document.getElementById('flist').innerHTML=feed.map(e=>`
    <div class="ev" style="--kc:${KIND_COLOR[e.kind]||'#9aa4b5'}"
         onclick="flyFrom(${e.lon||'null'},${e.lat||'null'})">
      <div class="top"><span class="dot" style="background:${KIND_COLOR[e.kind]}"></span>
        <span class="dd">${esc(e.district)}</span>${e.precise?'<span class="st">'+esc(e.street||'')+'</span>':''}
        <span class="tm">${esc(e.date)}</span>
        <span class="del" title="Убрать это сообщение"
              onclick="event.stopPropagation();delEvent('${esc(e.eid||'')}')">&times;</span></div>
      <div class="tx">${esc(e.text)}</div>
      <a href="${e.link}" target="_blank" onclick="event.stopPropagation()">источник ↗</a>
    </div>`).join('')||'<div style="color:var(--muted);font-size:12px">пока пусто</div>';
}
// ---- пуши (OneSignal) ----
// app_id подставляет сервер на выдаче страницы; пустая строка = не настроено.
const OS_APPID="cf5e7c2e-b4ef-4c24-aba0-750cf2f499cf", OS_SAFARI="web.onesignal.auto.548f76b5-1495-4e31-bc8e-b1b76d8ec8fd",
      OS_SITE="https://map.gde.wtf";
let osReady=false, osLoading=null, osError='';
function isIOS(){ return /iPad|iPhone|iPod/.test(navigator.userAgent||''); }
function isStandalone(){
  return (window.matchMedia&&matchMedia('(display-mode: standalone)').matches)
         || navigator.standalone===true;
}
function pushWhy(){
  // Возвращаем причину, по которой подписка невозможна, или ''.
  // Порядок проверок важен. На айфоне в обычной вкладке Safari объекта
  // PushManager нет вообще — Apple отдаёт его только приложению с экрана
  // «Домой». Если сначала спрашивать про возможности браузера, человек
  // видит «не поддерживаются» и не узнаёт, что делать. Поэтому сперва
  // адрес, потом айфон, и только потом всё остальное.
  if(!OS_APPID) return 'нет';
  if(OS_SITE){
    try{
      if(new URL(OS_SITE).origin !== location.origin) return 'другой адрес';
    }catch(e){}
  }
  if(isIOS() && !isStandalone()) return 'нужно установить';
  if(!('serviceWorker' in navigator)||!('PushManager' in window))
    return 'браузер не умеет';
  return '';
}
function osLoad(){
  if(osLoading) return osLoading;
  const load=new Promise((res,rej)=>{
    const s=document.createElement('script');
    s.src='https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js';
    s.defer=true; s.onload=res;
    s.onerror=()=>rej(new Error('SDK не загрузился: блокировщик или сеть'));
    document.head.appendChild(s);
  }).then(()=>new Promise((res,rej)=>{
    window.OneSignalDeferred=window.OneSignalDeferred||[];
    OneSignalDeferred.push(async function(OneSignal){
      try{
        const opt={appId:OS_APPID,
          serviceWorkerPath:'OneSignalSDKWorker.js',
          serviceWorkerParam:{scope:'/'},
          autoResubscribe:true,
          // Свой экран вместо их слайд-дауна: на айфоне разрешение
          // спрашивается только по нажатию человека, иначе молча не сработает.
          promptOptions:{slidedown:{prompts:[]}}};
        if(OS_SAFARI) opt.safari_web_id=OS_SAFARI;
        await OneSignal.init(opt);
        osReady=true; res(OneSignal);
      }catch(e){ rej(e); }      // иначе отказ init утонет, а промис зависнет
    });
  }));
  // Колбэк может не позвать нас вовсе — например когда в OneSignal указан
  // другой адрес сайта. Без срока ожидания страница молча висела бы на
  // «проверяю…», а блок подписки так и не появился бы.
  const guard=new Promise((_,rej)=>setTimeout(
    ()=>rej(new Error('OneSignal не ответил за 10 секунд')), 10000));
  osLoading=Promise.race([load, guard]).catch(e=>{
    osError=(e && e.message) || String(e);
    throw e;
  });
  return osLoading;
}
// ---- что присылать: теги pmode/quiet у подписки ----
// Сервер по ним отбирает, кому слать «внимание». Тревога идёт всем.
function prefGet(k,d){ try{ return localStorage.getItem('glrnd_'+k)||d; }catch(e){ return d; } }
function prefSet(k,v){ try{ localStorage.setItem('glrnd_'+k,v); }catch(e){} }
function prefsUI(){
  const m=prefGet('pmode','danger'), q=prefGet('quiet','0')==='1';
  document.querySelectorAll('#pmode button').forEach(b=>
    b.classList.toggle('on', b.dataset.v===m));
  const h=document.getElementById('pmode_hint');
  if(h) h.textContent = m==='all'
    ? 'Ещё и «внимание»: когда над городом слышны дроны, но до опасности не дошло.'
    : 'Пуш, когда в городе опасно: взрывы, работа ПВО, много дронов.';
  const qr=document.getElementById('quietrow'), qc=document.getElementById('quietcap');
  if(qr) qr.style.display = m==='all' ? 'flex' : 'none';
  if(qc) qc.style.display = m==='all' ? 'block' : 'none';
  const qb=document.getElementById('pquiet'); if(qb) qb.checked=q;
}
async function prefsPush(){
  if(!osReady) return;
  try{ await window.OneSignal.User.addTags({pmode:prefGet('pmode','danger'),
                                             quiet:prefGet('quiet','0')}); }catch(e){}
}
async function pushTag(){
  if(!osReady) return;
  try{
    const OS=window.OneSignal;
    await OS.User.addTag('city',CITY);
  }catch(e){}
  prefsPush();
}
// ---- «рядом со мной» ----
// Точку огрубляем прямо здесь, до того как она куда-либо уедет:
// для пяти километров этого хватает с запасом, а адрес по ней не берётся.
const NEAR_GRID=0.01;
function nearCoarse(v){ return Math.round(v/NEAR_GRID)*NEAR_GRID; }
function nearOn(){ try{ return localStorage.getItem('glrnd_near')==='1'; }
                   catch(e){ return false; } }
function nearSet(v){ try{ localStorage.setItem('glrnd_near',v?'1':'0'); }
                     catch(e){} }
function subId(){
  try{ return (window.OneSignal&&OneSignal.User&&
               OneSignal.User.PushSubscription&&
               OneSignal.User.PushSubscription.id)||''; }
  catch(e){ return ''; }
}
async function nearSend(lat,lon){
  const id=subId();
  if(!id) return 'подписка ещё не готова';
  try{
    const r=await fetch('/api/push/where',{method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({id:id,city:CITY,
        lat:+nearCoarse(lat).toFixed(4), lon:+nearCoarse(lon).toFixed(4)})});
    const d=await r.json();
    return (r.ok&&d.ok)?'':(d.error||'сервер не принял');
  }catch(e){ return 'нет связи с сервером'; }
}
async function nearOff(){
  const id=subId();
  if(!id) return;
  try{
    await fetch('/api/push/where',{method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({id:id,off:1})});
  }catch(e){}
}
function nearUI(state){
  const box=document.getElementById('nearbox');
  if(!box) return;
  const st=document.getElementById('near_st');
  const b=document.getElementById('near_btn');
  const h=document.getElementById('near_hint');
  const on=state==='on';
  if(st) st.textContent = state==='wait' ? 'включаю…'
    : (on ? 'включена' : (state==='nogeo' ? 'нет доступа к месту'
                                          : 'выключена'));
  if(b){ b.textContent = on?'Выключить':'Включить';
         b.classList.toggle('off',on);
         b.disabled = state==='wait'; }
  if(h && state==='nogeo')
    h.textContent='Браузер не дал геопозицию. Разреши её для этого сайта '
      +'в настройках — без неё расстояние посчитать не из чего.';
}
async function nearRefresh(){
  // Тихое обновление на каждом заходе: человек мог переехать, а подписка
  // могла смениться. Разрешение при этом уже есть — окна не будет.
  const box=document.getElementById('nearbox');
  if(!box) return;
  if(!nearOn()){ nearUI('off'); return; }
  try{
    const p=await locate();
    const why=await nearSend(p.coords.latitude,p.coords.longitude);
    nearUI(why?'off':'on');
  }catch(e){ nearUI('nogeo'); }
}
async function nearToggle(){
  if(nearOn()){
    nearSet(false); await nearOff(); nearUI('off');
    toast('Сигнал «рядом» выключен');
    return;
  }
  nearUI('wait');
  let p=null;
  try{ p=await locate(); }
  catch(e){ nearUI('nogeo'); toast('Без геопозиции не выйдет',true); return; }
  const why=await nearSend(p.coords.latitude,p.coords.longitude);
  if(why){ nearUI('off'); toast(why,true); return; }
  nearSet(true); nearUI('on');
  toast('Буду будить, если прилетит рядом');
}
function pushUI(state){
  const g=document.getElementById('pushg');
  if(!g) return;
  const why=pushWhy();
  if(why==='нет'){ g.style.display='none'; return; }
  g.style.display='block';
  const st=document.getElementById('push_st');
  const b=document.getElementById('push_btn');
  const h=document.getElementById('push_hint');
  if(why){
    const T={'нужно установить':['нужно установить',
        'На айфоне пуши работают только у приложения с экрана «Домой»: '
        +'«Поделиться» → «На экран «Домой»», потом открой его и вернись сюда.'],
      'другой адрес':['открыто не с того адреса',
        'Уведомления привязаны к адресу '+(OS_SITE||'')+'. Эта страница '
        +'открыта с '+location.origin+' — открой карту по правильному адресу, '
        +'и если приложение стояло на экране «Домой», переставь его оттуда.'],
      'браузер не умеет':['не поддерживаются',
        isIOS()
          ? 'Нужна iOS 16.4 или новее — на более старых веб-пуши не работают '
            +'даже у установленного приложения.'
          : 'Этот браузер не умеет пуши. Попробуй Chrome, Edge или Firefox.']};
    const t=T[why]||T['браузер не умеет'];
    if(st) st.textContent=t[0];
    if(h) h.textContent=t[1];
    if(b) b.style.display='none';
    return;
  }
  if(state==='wait'){
    if(st) st.textContent='проверяю…';
    if(b) b.style.display='none';
    return;
  }
  if(state==='err'){
    if(st) st.textContent='не завелось';
    if(b) b.style.display='none';
    if(h) h.textContent=(osError||'неизвестная ошибка')
      +'. Чаще всего это значит, что в OneSignal у приложения указан другой '
      +'Site URL — должен быть ровно '+(OS_SITE||location.origin)+'.';
    return;
  }
  if(b) b.style.display='block';
  // «Рядом» без включённых пушей смысла не имеет: слать будет некуда.
  const nb=document.getElementById('nearbox');
  if(nb) nb.style.display = state==='on' ? 'block' : 'none';
  const po=document.getElementById('pushopts');
  if(po){ po.style.display = state==='on' ? 'block' : 'none'; prefsUI(); }
  if(st) st.textContent = state==='on' ? 'включены'
    : (state==='denied' ? 'запрещены в браузере' : 'выключены');
  if(b){
    b.textContent = state==='on' ? 'Выключить' : 'Включить';
    b.classList.toggle('off', state==='on');
    b.disabled = (state==='denied');
  }
  if(h && state==='denied')
    h.textContent='Уведомления запрещены в настройках браузера для этого '
      +'сайта — там же их можно вернуть.';
}
async function pushRefresh(){
  if(pushWhy()){ pushUI(''); return; }
  // Блок показываем сразу, не дожидаясь SDK: если он не поднимется,
  // человек должен увидеть причину, а не пустое место.
  pushUI('wait');
  try{
    const OS=await osLoad();
    const on = OS.User.PushSubscription.optedIn && OS.Notifications.permission;
    // Тег ставим на каждом заходе, а не только в момент подписки: кто
    // подписался раньше тегов — иначе так и остался бы без города, и
    // адресная рассылка его не находила.
    if(on) await pushTag();
    pushUI(on?'on':(Notification.permission==='denied'?'denied':'off'));
    if(on) nearRefresh();
  }catch(e){ pushUI('err'); }
}
async function pushToggle(){
  const b=document.getElementById('push_btn');
  // Safari разрешает спрашивать про уведомления только по живому нажатию.
  // Если SDK ещё грузится, ожидание сети «съедает» жест и окно не
  // появляется вообще — молча. Поэтому грузим и просим нажать ещё раз.
  if(!osReady){
    if(b){ b.disabled=true; b.textContent='Готовлю…'; }
    let bad=false;
    try{ await osLoad(); }catch(e){ bad=true; }
    if(b){ b.disabled=false; }
    if(bad){ pushUI('err'); toast('OneSignal не отвечает',true); return; }
    pushUI('off');
    toast('Готово, нажми ещё раз');
    return;
  }
  if(b){ b.disabled=true; b.textContent='Секунду…'; }
  try{
    const OS=window.OneSignal;
    const on = OS.User.PushSubscription.optedIn && OS.Notifications.permission;
    if(on){
      await nearOff(); nearSet(false);
      await OS.User.PushSubscription.optOut();
      toast('Пуши выключены');
    }else{
      if(!OS.Notifications.permission) await OS.Notifications.requestPermission();
      if(!OS.Notifications.permission){
        pushUI(Notification.permission==='denied'?'denied':'off');
        if(b) b.disabled=false;
        return;
      }
      await OS.User.PushSubscription.optIn();
      await pushTag();
      toast('Пуши включены · '+cityShort());
    }
  }catch(e){ toast('не вышло включить пуши',true); }
  if(b) b.disabled=false;
  pushRefresh();
}

// ---- уборка мусора (только админ) ----
// Сервер всё равно проверит права, тут просто чтобы кнопок не было видно.
async function admDo(body, what){
  try{
    const r=await fetch('/api/admin/action',{method:'POST',
      headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
    const d=await r.json();
    if(!r.ok||d.error){ toast(d.error||'не вышло',true); return; }
    toast(what+(d.removed?(' · убрано '+d.removed):''));
    tickEtag=''; await tickNow();
  }catch(e){ toast('нет связи с сервером',true); }
}
function delEvent(eid){
  if(!eid) return;
  admDo({do:'del_event',eid:eid},'Сообщение убрано');
}
function delDistrict(d){
  if(!d) return;
  // Два вопроса, а не один: «Ростов» надо убрать, но название законное —
  // из таганрогского чата «в Ростове бахнуло» должно работать дальше.
  if(!confirm('Убрать «'+d+'» с карты?\nВсе его сообщения исчезнут.')) return;
  const ban=confirm('Больше не пускать такое название?\n\n'+
    'ОК — запомнить как мусор (для выдуманных вроде «Полна людей»).\n'+
    'Отмена — просто убрать сейчас.');
  admDo({do:'del_district',district:d,ban:ban?1:0},
        'Район «'+d+'» убран'+(ban?' и в стоп-листе':''));
}
function delMark(id){
  if(!id) return;
  admDo({do:'del_mark',id:id},'Метка убрана');
}
function fly(lon,lat){ if(!map||lon==null||lat==null) return; map.flyTo({center:[lon,lat],zoom:14.5,duration:900}); }
// Живой дрон: >=3 свежих (<3 мин) сообщений о дроне/ПВО/взрыве -> иконка в точке полёта
let droneMarker=null;
function updateDrone(now){
  if(!map) return;
  const live=all.filter(e=>e.lon!=null&&e.ts>=now-180&&
    (e.kind==='Гул дронов'||e.kind==='Взрыв'||e.kind==='ПВО'||e.kind==='Слышно'));
  if(live.length>=3){
    live.sort((a,b)=>a.ts-b.ts);
    let lat=0,lon=0,tw=0;
    live.forEach((p,i)=>{const w=i+1;lat+=p.lat*w;lon+=p.lon*w;tw+=w;});
    const pos=[lon/tw,lat/tw];
    if(!droneMarker){
      const el=document.createElement('div');
      el.className='drone';
      el.innerHTML='<div class="pulse"></div>'+
        '<svg viewBox="0 0 40 40" fill="none" stroke="#f5d76e" stroke-width="2">'+
        '<circle cx="10" cy="10" r="6" opacity=".9"/><circle cx="30" cy="10" r="6" opacity=".9"/>'+
        '<circle cx="10" cy="30" r="6" opacity=".9"/><circle cx="30" cy="30" r="6" opacity=".9"/>'+
