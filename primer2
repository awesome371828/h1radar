async function pollLogin(nonce){
  if(!nonce) return false;
  try{
    const p=await (await fetch('/api/auth/poll?nonce='+encodeURIComponent(nonce),
                               {cache:'no-store'})).json();
    if(p.ok){ pendNonce(null); if(gatePoll) clearInterval(gatePoll); location.reload(); return true; }
    if(p.expired){
      pendNonce(null);
      if(gatePoll) clearInterval(gatePoll);
      const w=document.getElementById('gwait'); if(w) w.style.display='none';
      const e=document.getElementById('gerr');
      if(e) e.textContent='код устарел, нажми вход заново';
    }
  }catch(e){}
  return false;
}
function watchLogin(nonce){
