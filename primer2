async function routeTo(id,btn){
  const it=(SH&&SH.items||[]).find(x=>x.id===id); if(!it||it.lat==null) return;
  if(btn){ btn.disabled=true; btn.textContent='Строю…'; }
  try{
    if(!myPos || Date.now()-myPos.t>120000){
      const p=await locate();
      myPos={lat:p.coords.latitude,lon:p.coords.longitude,acc:p.coords.accuracy||0,t:Date.now()};
      showMe();
    }
  }catch(e){
    toast('Без геопозиции маршрут не построить',true);
    if(btn){ btn.disabled=false; btn.textContent='Маршрут'; } return;
  }
  const box=document.getElementById('shroute'), t=document.getElementById('shroute_t');
  let coords, text;
  try{
    const r=await fetch('/api/route?from='+myPos.lat+','+myPos.lon+'&to='+it.lat+','+it.lon,{cache:'no-store'});
    const d=await r.json();
    if(!r.ok||!d.ok) throw new Error(d.error||'нет маршрута');
    coords=d.coords;
    text='<b>'+shFmt(d.distance)+'</b> · '+Math.max(1,Math.round(d.duration/60))+' мин пешком до «'+esc(it.addr)+'»';
    routeLayer(coords,false);
    ROUTE=routePrep(it,coords,d.steps||[]);
  }catch(e){
    // роутер недоступен — рисуем по прямой пунктиром и честно пишем об этом
    coords=[[myPos.lon,myPos.lat],[it.lon,it.lat]];
    text='Маршрут по улицам не построился, показываю напрямую: <b>'+
      shFmt(shDist(myPos.lat,myPos.lon,it.lat,it.lon))+'</b>';
    routeLayer(coords,true);
    ROUTE=routePrep(it,coords,[]);
  }
  t.innerHTML=text; box.classList.add('on');
  routeOn=true; shMode();
  // на телефоне панель закрывает полэкрана — сворачиваем её в строку внизу
  const phone=isPhone();
  if(phone){
