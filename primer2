function renderCityPick(){
  const sel=document.getElementById('citysel');
  if(!sel) return;
  const q=document.getElementById('citysearch');
  const paint=()=>{
    const text=(q&&q.value||'').toLowerCase().trim();
    const list=CITIES.filter(c=>!text||(c.short||'').toLowerCase().includes(text)
      ||(c.name||'').toLowerCase().includes(text));
    sel.innerHTML=list.length?list.map(c=>
      `<option value="${c.id}"${c.id===CITY?' selected':''}>${esc(c.short)}</option>`).join('')
      :'<option value="">Ничего не найдено</option>';
    if(list.length===1) sel.value=list[0].id;
    else if(list.some(c=>c.id===CITY)) sel.value=CITY;
    return list;
  };
  paint();
  if(q){
    q.oninput=paint;
    q.onkeydown=e=>{
      if(e.key!=='Enter') return;
      e.preventDefault();
      const list=CITIES.filter(c=>{
        const t=q.value.toLowerCase().trim();
        return !t||(c.short||'').toLowerCase().includes(t)||(c.name||'').toLowerCase().includes(t);
      });
      if(list.length===1){ q.value=''; setCity(list[0].id,true); }
      else if(sel.value){ const id=sel.value; q.value=''; setCity(id,true); }
    };
  }
  sel.onchange=()=>{ if(q) q.value=''; setCity(sel.value,true); };
  const g=document.getElementById('geocity');
  if(g) g.onclick=(e)=>{ e.preventDefault(); geoDetectCity(); };
}
