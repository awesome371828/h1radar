// перекрашиваем базовый стиль под синюю палитру интерфейса
function tintMap(){
  let ls=[];
  try{ ls=(map.getStyle()||{}).layers||[]; }catch(e){ return; }
  const set=(id,k,v)=>{ try{ map.setPaintProperty(id,k,v); }catch(e){} };
  for(const L of ls){
    const id=String(L.id||''), s=id.toLowerCase(), t=L.type;
    try{
      // Подложка нарочно почти бесцветная, в графитово-синем: интерфейс
      // насыщенно-голубой, и если карта тоже синяя — всё сливается.
      // Контраст здесь строится не на оттенке, а на насыщенности.
      if(t==='background'){ set(id,'background-color','#0c1723'); }
      else if(t==='fill'){
        if(/water|ocean|sea|river|lake|pond/.test(s)){
          set(id,'fill-color','#18394f'); set(id,'fill-opacity',.95);
        } else if(/build/.test(s)){
          set(id,'fill-color','#1d2a38'); set(id,'fill-opacity',.8);
        } else if(/park|wood|forest|grass|green|garden|pitch/.test(s)){
          set(id,'fill-color','#162a2c'); set(id,'fill-opacity',.75);
        } else if(/aeroway|airport/.test(s)){
          set(id,'fill-color','#182430'); set(id,'fill-opacity',.7);
        } else {
          set(id,'fill-color','#121d29'); set(id,'fill-opacity',.65);
        }
      }
      else if(t==='line'){
        if(/water|river|stream/.test(s)) set(id,'line-color','#2b5f7d');
        else if(/motorway|trunk/.test(s)) set(id,'line-color','rgba(214,224,236,.60)');
        else if(/primary|secondary/.test(s)) set(id,'line-color','rgba(196,209,226,.40)');
        else if(/rail|transit/.test(s)) set(id,'line-color','rgba(190,205,222,.20)');
        else if(/boundary|admin|border/.test(s)) set(id,'line-color','rgba(205,218,235,.30)');
        else set(id,'line-color','rgba(178,194,214,.24)');
      }
      else if(t==='symbol'){
        set(id,'text-halo-color','rgba(6,12,20,.92)');
        set(id,'text-halo-width',1.4);
        if(/water|river|sea/.test(s)) set(id,'text-color','#9dc0d6');
        else if(/place|city|town|village|settlement/.test(s)) set(id,'text-color','#eef2f8');
        else set(id,'text-color','#c2cedd');
      }
    }catch(e){}
  }
}
