<script>
const KEY="fU3vlMsMn4Jb6dnEIFsx";
const KIND_COLOR={"Взрыв":"#ff5f6b","Ракета":"#ff3bd0","ПВО":"#ff9640","Сирена":"#ff9640","Вертолёты":"#4ec9e8","Самолёты":"#c084fc","Гул дронов":"#f5c04e","Слышно":"#f5c04e","Отметка":"#b8c0cf","Отбой":"#34d399","Вопрос":"#5a6373","Сообщ.":"#9aa4b5"};
const DOM_COLOR={"Взрыв":"#ff5f6b","Ракета":"#ff3bd0","ПВО":"#ff9640","Вертолёты":"#4ec9e8","Самолёты":"#c084fc"};
const compass=b=>['С','СВ','В','ЮВ','Ю','ЮЗ','З','СЗ'][Math.round(b/45)%8];
const DOT_TTL=300, EMPTY={type:'FeatureCollection',features:[]};
const esc=s=>(s||"").replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let map, hours=24, all=[], attacks=[], explMarkers={};
// ---- город ----
// Выбранный город — это и центр карты, и то, чью тревогу мы показываем.
// При первом заходе пробуем определить по геопозиции: человеку из
// Таганрога незачем видеть ростовскую тревогу. Отказал в геопозиции —
// остаёмся на городе по умолчанию, сменить можно в профиле.
let CITIES=[], CITY='rostov', cityAuto=true;
try{
  const v=localStorage.getItem('glrnd_city');
  if(v){ CITY=v; cityAuto=(localStorage.getItem('glrnd_city_auto')!=='0'); }
}catch(e){}
function cityById(id){ return CITIES.find(c=>c.id===id)||null; }
document.addEventListener('DOMContentLoaded',()=>{
  const x=cwEl('cw_x'), close=cwEl('cw_close'), check=cwEl('cw_check'), send=cwEl('cw_send');
  if(x) x.onclick=()=>cwHide();
  if(close) close.onclick=()=>cwHide();
  if(check) check.onclick=()=>cwPoll();
  if(send) send.onclick=()=>{
    const v=(cwEl('cw_inp')&&cwEl('cw_inp').value||'').trim();
    if(!v){ cwErr('Напиши название города'); return; }
    requestCity(CW.lat,CW.lon,v);
  };
  try{
    const w=JSON.parse(localStorage.getItem('glrnd_city_wait')||'null');
    if(w && w.id && Date.now()-w.ts<86400000){
      CW.req=w; cwShow(); cwState('pending',{request:w});
      CW.timer=setInterval(cwPoll,15000);
    }
  }catch(e){}
});
function cityShort(id){ const c=cityById(id||CITY); return c?c.short:''; }
function citySave(manual){
  cityAuto=!manual;
  try{
    localStorage.setItem('glrnd_city',CITY);
    localStorage.setItem('glrnd_city_auto',manual?'0':'1');
    // центр кладём рядом: список городов приезжает только с первым
    // ответом сервера, а карту надо поставить правильно сразу, иначе
    // таганрожец при каждом заходе видит перелёт из Ростова
    const c=cityById(CITY);
    if(c) localStorage.setItem('glrnd_city_ll',[c.lon,c.lat,c.zoom].join(','));
  }catch(e){}
}
function cityStartView(){
  try{
    const v=(localStorage.getItem('glrnd_city_ll')||'').split(',').map(Number);
    if(v.length===3 && v.every(x=>isFinite(x)))
      return {center:[v[0],v[1]],zoom:v[2]};
  }catch(e){}
  return null;
}
let CW={req:null,timer:null,lat:0,lon:0,busy:false};
function cwEl(id){ return document.getElementById(id); }
function cwShow(){ const w=cwEl('citywait'); if(w) w.classList.add('on'); }
function cwHide(keep){
  const w=cwEl('citywait'); if(w) w.classList.remove('on');
  if(!keep && CW.timer){ clearInterval(CW.timer); CW.timer=null; }
}
function cwErr(t){ const e=cwEl('cw_err'); if(e) e.textContent=t||''; }
function cwSteps(n){
  const box=cwEl('cw_steps'); if(!box) return;
  [...box.children].forEach((el,i)=>{
    el.className='cw-step'+(i<n-1?' done':(i===n-1?' now':''));
  });
}
function cwState(kind,d){
  d=d||{}; cwShow(); const t=cwEl('cw_t'), p=cwEl('cw_p'), ico=cwEl('cw_ico');
  const nameBox=cwEl('cw_name'), check=cwEl('cw_check'), close=cwEl('cw_close');
  if(nameBox) nameBox.style.display=kind==='needname'?'flex':'none';
  if(check) check.style.display=kind==='needname'?'none':'inline-block';
  if(close) close.textContent=kind==='needname'?'Отмена':'Пока смотреть карту';
  cwErr('');
  if(kind==='lookup'){
    if(ico) ico.textContent='⌖';
    if(t) t.textContent='Ищем твой город';
    if(p) p.textContent='Определяем, где ты, и есть ли этот город на карте.';
    cwSteps(1);
  }else if(kind==='needname'){
    if(ico) ico.textContent='?';
    if(t) t.textContent='Как называется твой город?';
    if(p) p.textContent='Геокодер не смог определить название — напиши его, и мы добавим город.';
    cwSteps(1);
  }else if(kind==='pending'){
    const nm=(d.request&&d.request.name)||(d.city&&d.city.name)||'твой город';
    if(ico) ico.textContent='＋';
    if(t) t.textContent='Добавляем '+nm;
    if(p) p.innerHTML='Города <b>'+esc(nm)+'</b> пока нет на карте. Заявка уже у команды: обычно это занимает от нескольких часов до пары дней — всё зависит от городского чата.';
    cwSteps(2);
  }
