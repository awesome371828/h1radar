async function navReroute(lat,lon){
  NAV.lastRe=Date.now();
  document.getElementById('nv_do').textContent='Перестраиваю маршрут…';
  navSay('Перестраиваю маршрут');
  try{
    const it=ROUTE.it;
    const r=await fetch('/api/route?from='+lat+','+lon+'&to='+it.lat+','+it.lon,{cache:'no-store'});
    const d=await r.json(); if(!r.ok||!d.ok) throw 0;
    ROUTE=routePrep(it,d.coords,d.steps); NAV.along=0; NAV.said={};
    routeLayer(d.coords,false);
  }catch(e){ /* не вышло — ведём по старому, попробуем позже */ }
}
function navFix(pos){
  if(!NAV||!ROUTE) return;
  const c=pos.coords, lat=c.latitude, lon=c.longitude, acc=c.accuracy||50;
  myPos={lat,lon,acc,t:Date.now()}; showMe();
  document.getElementById('nv_gps').hidden=acc<=60;
  if(NAV.done) return;
  const it=ROUTE.it;
  if(shDist(lat,lon,it.lat,it.lon)<25){ navArrive(); return; }
  const pr=routeProject(ROUTE,lon,lat,NAV.along);
  if(!pr) return;
  // ушёл с маршрута: две точные точки подряд дальше 40 м — перестраиваем
  if(pr.off>40 && acc<50){ NAV.off++; } else NAV.off=0;
  if(NAV.off>=2 && Date.now()-NAV.lastRe>12000){ navReroute(lat,lon); return; }
  NAV.along=Math.max(NAV.along-15,pr.along);
  const left=Math.max(0,ROUTE.total-NAV.along);
  if(left<15){ navArrive(); return; }
  // пройденное гаснет: рисуем только то, что впереди
  const rest=[[lon,lat]].concat(ROUTE.coords.slice(pr.i));
  routeLayer(rest,false);
  const next=ROUTE.steps.find(s=>s.at>NAV.along+5) || {type:'arrive',at:ROUTE.total,name:''};
  const toStep=next.at-NAV.along;
  document.getElementById('nv_in').textContent=fmtIn(toStep);
  document.getElementById('nv_do').textContent=stepDo(next);
  document.getElementById('nv_st').textContent=next.name||'';
  const deg=next.type==='arrive'?0:(MOD_DEG[next.mod]||0);
  const svg=document.querySelector('#nv_ar svg'); if(svg) svg.style.transform='rotate('+deg+'deg)';
  document.getElementById('nv_left').textContent=shFmt(left)+' · '+Math.max(1,Math.round(left/75))+' мин';
  // голос: один раз заранее и ещё раз прямо перед поворотом
  const key=next.at+'|'+next.type+'|'+next.mod;
  const phrase=stepDo(next)+(next.name?', '+next.name:'');
  if(!NAV.said[key]){ NAV.said[key]=1; navSay(sayIn(toStep)+' '+phrase.toLowerCase()); }
  else if(toStep<25 && !NAV.said[key+'!']){ NAV.said[key+'!']=1; navSay('Сейчас '+phrase.toLowerCase()); navBuzz(120); }
  // камера за человеком; направление — по движению или по маршруту впереди
  if(NAV.follow && map){
    let brg=(c.heading!=null && c.speed>0.6)?c.heading:null;
    if(brg==null){ const a=ROUTE.coords[Math.max(0,pr.i-1)], b=ROUTE.coords[Math.min(ROUTE.coords.length-1,pr.i)];
      brg=Math.atan2((b[0]-a[0])*Math.cos(lat*Math.PI/180),b[1]-a[1])*180/Math.PI; }
    map.easeTo({center:[lon,lat],zoom:17.2,pitch:45,bearing:brg,duration:900,
      padding:{top:150,bottom:110,left:0,right:0}});
  }
}
