async function tickNow(){
  let s=null;
  try{
    const h='?city='+encodeURIComponent(CITY)+(hours?('&hours='+hours):'');
    const r=await fetch('/api/tick'+h,{cache:'no-store',
      headers:tickEtag?{'If-None-Match':tickEtag}:{}});
    if(r.status===401){ await checkMe(); return; }
    if(r.status===304){ return; }              // ничего не поменялось
    const et=r.headers.get('ETag'); if(et) tickEtag=et;
    const d=await r.json();
    if(d.cities && d.cities.length){
      const had=CITIES.length;
      CITIES=d.cities;
      if(!had) onCitiesReady();
    }
    all=d.events||[]; attacks=d.attacks||[];
    applyMarks(d.marks||{});
    applyTracks(d.tracks||[]);
    apply();
    renderCustom(d.custom||[]);
    maintApply(d.maint);
    noticeApply(d.notice);
    sirenApply(d.siren);
    if(bootBuild && d.build && d.build!==bootBuild){ location.reload(); return; }
    if(d.build) bootBuild=d.build;
    s=d.status;
  }catch(e){ return; }
  try{
    if(!s) return;
    lastLevel=s.level|0;
    const el=document.getElementById('alarm');
    el.className='l'+s.level+((s.feed&&s.feed!=='live'&&!s.level)?' nodata':'');
    document.getElementById('al_t').textContent=s.short||s.label;
    document.getElementById('al_w').textContent=
      s.level? (s.top.length? s.top.slice(0,2).map(t=>t.d).join(' · ') : 'район не назван') : '';
    const f=document.getElementById('al_full'); if(f) f.textContent=s.label;
    showOblast(s.region);
    const rg=s.region||{};
    const rgb=document.getElementById('s_rg');
    if(rgb){
      const L={calm:'тихо',attention:'внимание',danger:'опасность'};
      rgb.textContent=rg.ok?(L[rg.level]||rg.level):'нет данных';
      rgb.style.color=rg.ok&&rg.level!=='calm'?'var(--hot)':'';
    }
    const rg2=document.getElementById('s_rg2');
    if(rg2) rg2.textContent=(rg.ok&&rg.text)?rg.text
      :'внешняя сводка по Ростовской области';
    const c=document.getElementById('al_c');
    if(c) c.textContent=`за ${s.window_min} мин · взрывы ${s.booms} · `+
                        `ПВО ${s.pvo} · дроны ${s.drones} · вопросы ${s.questions}`;
    document.title=(s.level?['','· внимание','· дроны','· ВЗРЫВЫ'][s.level]+' ':'')
      +(s.city_name||'Ростов-на-Дону')+' · монитор дронов';
  }catch(e){}
}
