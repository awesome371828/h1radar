      '<div class="r"><span class="p">'+(it.state==='pending'?'точку ещё ищем':'точка не найдена')+'</span>'+
      '<a href="'+q+'" target="_blank" rel="noopener">На карте →</a></div></div>';
  }
  const m=me?shDist(me.lat,me.lon,it.lat,it.lon):null;
