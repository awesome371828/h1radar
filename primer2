async function requestCity(lat,lon,name){
  if(CW.busy) return;
  if(CW.timer){ clearInterval(CW.timer); CW.timer=null; }
  CW.req=null;
  try{ localStorage.removeItem('glrnd_city_wait'); }catch(e){}
  CW.busy=true; CW.lat=lat; CW.lon=lon; cwShow(); cwState('lookup');
  try{
    const body={lat,lon}; if(name) body.name=name;
    const r=await fetch('/api/city/request',{method:'POST',
      headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
    const d=await r.json().catch(()=>({error:'сервер ответил странно'}));
    if(d.need_name){ cwState('needname'); return; }
    if(d.error){ cwErr(d.error); return; }
    if(d.request) CW.req=d.request;
    if(d.city && d.city.public){ cwDone(d.city,d.status); return; }
    if((d.status==='added'||d.status==='live') && d.city){ cwDone(d.city,d.status); return; }
    cwState('pending',d);
    if(d.request){
      try{ localStorage.setItem('glrnd_city_wait',
        JSON.stringify({id:d.request.id,name:d.request.name,ts:Date.now()})); }catch(e){}
    }
    if(!CW.timer) CW.timer=setInterval(cwPoll,8000);
  }catch(e){
    cwErr('Нет связи с сервером — попробуй ещё раз');
  }finally{
    CW.busy=false;
  }
}
function nearestCity(lat,lon){
  let best=null,bd=1e12;
  for(const c of CITIES){
    const dy=(lat-c.lat)*111320, dx=(lon-c.lon)*111320*Math.cos(lat*Math.PI/180);
    const d=Math.hypot(dx,dy);
    if(d<bd){ best=c; bd=d; }
  }
  return (best && bd<=best.radius) ? best.id : null;
}
