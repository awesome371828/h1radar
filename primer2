    '<div class="m">'+esc(it.kind)+(it.cap?' · до '+it.cap+' чел.':'')+(it.org?' · '+esc(it.org):'')+'</div>'+
    '<div class="r">'+(m!=null?'<span class="d">'+shFmt(m)+'</span><span>≈ '+Math.max(1,Math.ceil(m/75))+' мин</span>':'')+
    '<button class="rb" data-shroute="'+esc(it.id||'')+'" style="margin-left:auto">Маршрут</button>'+
    '<a class="ya" href="'+shRoute(it,me)+'" target="_blank" rel="noopener">в Яндексе</a></div></div>';
