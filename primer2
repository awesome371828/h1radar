let replayTimer=null;
function replay(id){
  const a=attacks.find(x=>x.id===id); if(!a||!map) return;
  const src=map.getSource('replay'); if(!src) return;
  if(replayTimer){ clearInterval(replayTimer); replayTimer=null; }
  const pts=a.points.slice().sort((x,y)=>x.ts-y.ts).filter(p=>p.lon!=null);
  if(!pts.length) return;
  const hud=document.getElementById('replayHud');
  hud.style.display='block';
  const step=Math.max(80,Math.min(650,Math.round(12000/pts.length)));
  let i=0, feats=[];
  src.setData(EMPTY);
  replayTimer=setInterval(()=>{
    if(i>=pts.length){
      clearInterval(replayTimer); replayTimer=null;
      hud.style.display='none';
      setTimeout(()=>{
        src.setData(EMPTY);
        const lb=map.getSource('replaylbl'); if(lb) lb.setData(EMPTY);
      },4000);
      return;
    }
    const p=pts[i++];
    feats.push({type:'Feature',geometry:{type:'Point',coordinates:[p.lon,p.lat]}});
    src.setData({type:'FeatureCollection',features:feats.slice()});
    const lbl=map.getSource('replaylbl');
    if(lbl) lbl.setData({type:'FeatureCollection',features:[{
      type:'Feature',geometry:{type:'Point',coordinates:[p.lon,p.lat]},
      properties:{n:String(i)}}]});
    hud.textContent='▶ повтор '+p.date+' · '+i+'/'+pts.length+' сообщ.';
  }, step);
}
