<script>
(function(){
  function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
  function track(id,e){ try{ var b=JSON.stringify({id:id,e:e}); if(navigator.sendBeacon){ navigator.sendBeacon('/api/popup/track',new Blob([b],{type:'application/json'})); } }catch(x){} }
  function show(p){
    var key='popup_seen_'+p.id;
    var o=document.createElement('div');
    o.id='gpopup'; o.setAttribute('role','dialog'); o.setAttribute('aria-modal','true');
    o.style.cssText='position:fixed;inset:0;z-index:99999;display:flex;align-items:center;justify-content:center;padding:18px;background:rgba(3,8,18,.74);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)';
    var h='<div style="position:relative;width:100%;max-width:420px;max-height:92vh;overflow:auto;background:#0b1730;border:1px solid rgba(160,200,255,.22);border-radius:20px;box-shadow:0 30px 80px rgba(0,0,0,.6);color:#eef5ff;font-family:-apple-system,Segoe UI,Roboto,Arial,sans-serif">'
      +'<button id="gpx" aria-label="Закрыть" style="position:absolute;top:10px;right:10px;z-index:2;width:34px;height:34px;border-radius:50%;border:0;background:rgba(4,10,24,.7);color:#fff;font-size:22px;line-height:1;cursor:pointer">&times;</button>';
    if(p.img) h+='<img src="'+esc(p.img)+'" alt="" style="display:block;width:100%;height:auto;border-radius:20px 20px 0 0">';
    h+='<div style="padding:18px 20px 20px">';
    if(p.title) h+='<div style="font-size:21px;font-weight:800;line-height:1.2;margin-bottom:8px">'+esc(p.title)+'</div>';
    if(p.text) h+='<div style="font-size:14.5px;line-height:1.55;color:#c3d3ea;white-space:pre-line">'+esc(p.text)+'</div>';
    if(p.btn_url&&p.btn_text) h+='<a id="gpb" href="'+esc(p.btn_url)+'" target="_blank" rel="noopener" style="display:block;text-align:center;margin-top:16px;background:#63dcff;color:#06101f;font-weight:800;font-size:15px;padding:13px;border-radius:12px;text-decoration:none">'+esc(p.btn_text)+'</a>';
    h+='</div></div>';
    o.innerHTML=h; document.body.appendChild(o);
    function close(){ if(o.parentNode) o.parentNode.removeChild(o);
      try{ if(p.mode==='once') localStorage.setItem(key,'1'); else if(p.mode==='session') sessionStorage.setItem(key,'1'); }catch(e){} }
    o.querySelector('#gpx').onclick=close;
    o.addEventListener('click',function(e){ if(e.target===o) close(); });
    document.addEventListener('keydown',function k(e){ if(e.key==='Escape'){ close(); document.removeEventListener('keydown',k); } });
    var b=o.querySelector('#gpb'); if(b) b.addEventListener('click',function(){ track(p.id,'click'); close(); });
    track(p.id,'view');
  }
  fetch('/api/popup',{cache:'no-store',credentials:'include'}).then(function(r){return r.json();}).then(function(p){
    if(!p||!p.on) return;
    var key='popup_seen_'+p.id;
    try{ if(p.mode==='once'&&localStorage.getItem(key)) return; if(p.mode==='session'&&sessionStorage.getItem(key)) return; }catch(e){}
    setTimeout(function(){ show(p); },1800);
  }).catch(function(){});
})();
</script>

