// iPhone-приложение: подгоняем высоту под реальный экран
(function(){
  const ua=navigator.userAgent||'';
  const ios=/iPad|iPhone|iPod/.test(ua)||(/Macintosh/.test(ua)&&navigator.maxTouchPoints>1);
  const std=navigator.standalone===true||
    (window.matchMedia&&matchMedia('(display-mode: standalone)').matches);
  if(!ios||!std) return;
  const root=document.documentElement;
  root.classList.add('iosapp');
  function fit(){
    const port=(window.innerHeight>=window.innerWidth);
    const scr=port?Math.max(screen.height,screen.width):Math.min(screen.height,screen.width);
    const H=Math.max(scr,window.innerHeight);
    root.style.setProperty('--apph',H+'px');
    const gap=H-window.innerHeight;
    if(gap>8&&gap<120){ root.style.setProperty('--vgap',gap+'px'); root.classList.add('vgap'); }
    else { root.classList.remove('vgap'); root.style.removeProperty('--vgap'); }
    window.scrollTo(0,0);
    try{ if(typeof map!=='undefined'&&map) map.resize(); }catch(e){}
  }
  fit();
  window.addEventListener('resize',()=>setTimeout(fit,60));
  window.addEventListener('orientationchange',()=>setTimeout(fit,300));
  window.addEventListener('pageshow',()=>setTimeout(fit,60));
  setTimeout(fit,400); setTimeout(fit,1500);
})();
// подсказка «поставь на экран Домой»: через 5 секунд, один раз
(function(){
  const el=document.getElementById('pwa');
  if(!el) return;
  const std=(window.matchMedia&&matchMedia('(display-mode: standalone)').matches)
            || navigator.standalone===true;
  if(std) return;
  if(!window.matchMedia('(max-width:760px)').matches) return;
  try{ if(+(localStorage.getItem('glrnd_pwa')||0) > Date.now()) return; }catch(e){}
  const ua=navigator.userAgent||'';
  const ios=/iPad|iPhone|iPod/.test(ua);
  const h=document.getElementById('pwa_h');
  if(h) h.textContent=ios ? '«Поделиться» внизу → «На экран «Домой»»'
                          : 'Меню браузера → «Установить»';
  let prompt=null;
  const go=document.getElementById('pwa_go');
  window.addEventListener('beforeinstallprompt',e=>{
    e.preventDefault(); prompt=e;
    if(go){ go.style.display='block';
      if(h) h.textContent='Одно нажатие — и радар на экране'; }
  });
  const hide=days=>{
    el.classList.remove('show');
    document.body.classList.remove('pwa-on');
    try{ localStorage.setItem('glrnd_pwa', Date.now()+days*86400000); }catch(e){}
  };
  if(go) go.addEventListener('click',async()=>{
    if(!prompt) return;
    prompt.prompt();
    try{ await prompt.userChoice; }catch(e){}
    prompt=null; hide(180);
  });
  document.getElementById('pwa_x').addEventListener('click',()=>hide(30));
  setTimeout(()=>{
    if(document.body.classList.contains('locked')) return;
    el.classList.add('show');
    document.body.classList.add('pwa-on');
    setTimeout(()=>{ if(el.classList.contains('show')) hide(3); },22000);
  },5000);
})();

// на телефоне шапка уезжает, пока листаешь список — она не должна закрывать текст
(function(){
  if(!window.matchMedia('(max-width:760px)').matches) return;
  const B=document.body;
  const bind=el=>{
    if(!el) return;
    let last=0;
    el.addEventListener('scroll',()=>{
      const y=el.scrollTop;
      if(y>44 && y>last+2) B.classList.add('barhide');
      else if(y<last-8 || y<=12) B.classList.remove('barhide');
      last=y;
    },{passive:true});
  };
  ['side','topd','feed','settings'].forEach(id=>bind(document.getElementById(id)));
})();
